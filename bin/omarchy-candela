#!/bin/bash

# omarchy:summary=Configure displays: geometry, signal and colour, with safe apply and revert
# omarchy:args=<state|apply|keep|revert|persist|hdr|brightness|identify|open|edid|icc|workspaces|virtual|recover|doctor> [...]
# omarchy:examples=omarchy-candela state | omarchy-candela hdr on --display DP-2 | omarchy-candela apply @layout.json | omarchy-candela keep | omarchy-candela doctor

# The backend behind the Candela plugin. Everything the UI does is a
# subcommand here, so it is scriptable and bindable.
#
# Model:
#   intent.json          what the user chose through this tool, per connector,
#                        and the workspace plan: a home display per workspace
#   pending.json         an applied-but-not-kept intent, with an expiry and a token
#   candela-layout.lua  generated from intent + live geometry; Omarchy loads it
#                        after the user's monitors.lua on every reload
#   candela-pending.lua the pending intent in the same form, loaded after the
#                        layout, so a reload from anywhere (Omarchy's clamshell
#                        script, a theme change) re-applies the preview instead
#                        of silently reverting it
#
# `apply` writes pending, applies live through `hyprctl eval` for EVERY
# connected display in one chunk (mixing explicit and auto positions moves
# displays), reads the compositor back to confirm it landed where asked, and
# starts a detached revert timer. `keep` commits pending to intent,
# regenerates the Lua, reloads, and proves the file ran. `revert` (or the
# timer) drops pending and reloads, which restores the last kept
# configuration.
#
# Virtual displays (VIRTUAL-1, VIRTUAL-2…) are Hyprland headless outputs this
# tool creates and owns. Their rules live in the layout file like any other,
# so the output itself only has to be created: by `virtual add`, and by the
# service each time the shell starts. They are seen through wayvnc.
#
# The workspace plan is written as workspace rules into the same layout file.
# A reload does not move workspaces that are already open, so a change to the
# plan moves them itself, and records where they were so revert can put them
# back.
#
# A laptop's built-in panel is switched off through Omarchy's own
# internal-monitor-disable toggle rather than a rule of ours: Omarchy's
# clamshell script honours that flag and would re-enable the panel over a
# plain rule within seconds of any monitor event, and Omarchy's boot-time
# recovery service already clears the flag when no external display is
# connected.

set -Eeuo pipefail
# A set -e exit with no message is the worst failure mode for a tool that
# arms display changes: say where it died. Only fires where errexit would.
trap 'echo "omarchy-candela: aborted at line $LINENO: $BASH_COMMAND" >&2' ERR

PLUGIN_ID="${OMARCHY_CANDELA_PLUGIN_ID:-io.github.pushmotta.candela}"
SELF="$(readlink -f "$0")"
SELF_DIR="$(dirname "$SELF")"
EDID_TOOL="$SELF_DIR/omarchy-candela-edid"

STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
STATE_DIR="${OMARCHY_CANDELA_STATE_DIR:-$STATE_HOME/omarchy/candela}"
INTENT_FILE="$STATE_DIR/intent.json"
PENDING_FILE="$STATE_DIR/pending.json"
LUA_FILE="${OMARCHY_CANDELA_LUA_FILE:-$STATE_HOME/omarchy/toggles/hypr/candela-layout.lua}"
# Everything below lives beside the layout: Omarchy loads that directory in
# sorted filename order, so "candela-layout" < "candela-pending" <
# "internal-monitor-*" is the precedence, and it is the one we want.
TOGGLES_DIR="$(dirname "$LUA_FILE")"
PENDING_LUA="${OMARCHY_CANDELA_PENDING_LUA_FILE:-$TOGGLES_DIR/candela-pending.lua}"
INTERNAL_FLAG="$TOGGLES_DIR/internal-monitor-disable.lua"   # Omarchy's own toggle, shared
INTERNAL_SCALE_FILE="$TOGGLES_DIR/internal-monitor-scale"    # read by Omarchy's clamshell script
# A change that cannot blank a real screen (the workspace plan, a virtual
# display) is kept at once, with no countdown, so this records what it
# replaced, for one `revert` to undo.
UNDO_FILE="$STATE_DIR/undo.json"
# How long that undo lasts: long enough to catch a mistake, not so long that
# a Revert pressed an hour later undoes something long forgotten (it did, on
# 5 October 2026: Revert removed a virtual display added an hour before).
UNDO_SECONDS="${OMARCHY_CANDELA_UNDO_SECONDS:-120}"
VIRTUAL_RE='^VIRTUAL-[0-9]+$'
VIRTUAL_DIR="$STATE_DIR/virtual"          # per display: wayvnc configs, key, password (0700)
VIRTUAL_GAP=320                            # logical px between the desk and a display placed apart
VNC_WAIT_SECONDS="${OMARCHY_CANDELA_VNC_WAIT_SECONDS:-3}"
WAYVNC="${OMARCHY_CANDELA_WAYVNC:-wayvnc}"   # the tests name one that is missing
UFW_DIR="${OMARCHY_CANDELA_UFW_DIR:-/etc}"   # the tests give one of their own
REVERT_UNIT="omarchy-candela-revert"
REVERT_SECONDS="${OMARCHY_CANDELA_REVERT_SECONDS:-15}"
VERIFY_SECONDS="${OMARCHY_CANDELA_VERIFY_SECONDS:-3}"
COMMAND_SECONDS="${OMARCHY_CANDELA_COMMAND_SECONDS:-2}"
# The calls that change displays (hyprctl eval of monitor rules, hyprctl
# reload) block for as long as the modeset takes, which is not a query's two
# seconds. 15 is a placeholder until a real mode switch has been timed.
APPLY_SECONDS="${OMARCHY_CANDELA_APPLY_SECONDS:-15}"
LOCK_SECONDS="${OMARCHY_CANDELA_LOCK_SECONDS:-2}"
# Longer than a keep can hold the lock: commit, reload, verify and, on
# failure, the restore path, each bounded by APPLY_SECONDS.
WATCHDOG_LOCK_SECONDS="${OMARCHY_CANDELA_WATCHDOG_LOCK_SECONDS:-45}"
INTERNAL_RE='^(eDP|LVDS|DSI)-'

# A transient systemd unit (the revert timer) may lack the compositor's
# instance signature; recover it from the newest instance runtime dir, the
# same way omarchy-restart-shell does.
if [[ -z ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
  # No runtime dir at all (Hyprland gone, or a test runner) must not be fatal:
  # with pipefail a failing find takes the whole substitution down with it.
  hypr_root="${XDG_RUNTIME_DIR:-/run/user/$UID}/hypr"
  if [[ -d $hypr_root ]]; then
    hypr_dir=$(find "$hypr_root" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' 2>/dev/null | sort -n | tail -n 1 | cut -d' ' -f2- || true)
    if [[ -n $hypr_dir ]]; then export HYPRLAND_INSTANCE_SIGNATURE=${hypr_dir##*/}; fi
  fi
fi

usage() {
  cat <<'USAGE'
Usage: omarchy-candela <command> [args]

  state                          JSON: displays, capabilities, live and kept config, pending apply
  apply [--now] <json|@file|->   Apply a change live; reverts in 15 s unless kept (--now keeps immediately)
  keep                           Keep the pending change and persist it
  revert [--expired] [--token T] Drop the pending change and restore the kept configuration
  persist                        Regenerate the layout file from the kept configuration
  hdr <on|off|wide> [--display NAME] [--sdr-white NITS] [--now]
  brightness <NAME> [+N%|N%-|N%] Show or set brightness for one display
  identify                       Flash each connector name on its own display
  open                           Open the Candela studio
  edid <NAME>                    Parsed EDID capabilities as JSON
  icc list                       Installed ICC profiles as JSON
  recover                        If every display is off, switch the built-in (or first) one back on
  doctor                         Check that the layout is loaded, the compositor agrees, and nothing fights it
  report                         Diagnostics for a bug report, as Markdown, with home paths, serials and EDID hashes removed
  workspaces home                Move every open workspace that is away from its home display back home
  virtual add <extra|stage|bench> [--size WxH] [--refresh HZ] [--scale S] [--beside NAME|--apart] [--label TEXT]
  virtual remove NAME            Stop its viewers, then remove the virtual display
  virtual view NAME window on|off   (a live picture in a Candela window; view only)
  virtual view NAME network on|off [--address IP] [--port N] [--at-login yes|no]
  virtual secret NAME [--new] [--qr]  The username and password for network viewing, as JSON
                                 (--new replaces the password, --qr adds it as a QR code)
  virtual clients NAME           Who is connected over the network, as JSON
  virtual disconnect NAME ID
  virtual restore                Recreate kept virtual displays (the service runs this at start)
  virtual guard                  Move workspaces parked on a virtual display to a real one
  virtual install                Install wayvnc (for network viewing) with Omarchy's installer, in a terminal

Change JSON shape (any subset per display):
  {"displays":[{"name":"DP-2","bitdepth":10,"cm":"hdr","sdr_max_luminance":203}],
   "global":{"cm_auto_hdr":1},
   "workspaces":{"homes":{"6":"DP-2"},"shows":{"DP-2":"6"}}}
  Workspace homes are workspaces 1 to 10; null removes one, and
  "workspaces":null turns the plan off. A change that only touches the plan
  and virtual displays is kept at once, and `revert` undoes it.
USAGE
}

die() { echo "omarchy-candela: $*" >&2; exit 1; }

now_epoch() { date +%s; }
now_ms() { echo $(( $(date +%s%N) / 1000000 )); }

is_internal() { [[ $1 =~ $INTERNAL_RE ]]; }

# Serialize the commands that write state (apply/keep/revert/persist/hdr/recover,
# the last two of which call cmd_apply in-process) so a concurrent invocation —
# an expired revert racing an interactive keep, say — cannot interleave.
acquire_lock() {
  mkdir -p "$STATE_DIR"
  exec 9>"$STATE_DIR/.lock"
  flock -w "$LOCK_SECONDS" 9 || die "state lock is busy; recovery was not discarded"
}

# The detached revert is the last recovery route. A foreground command may
# briefly own the lock when the deadline fires, so retry instead of dropping
# the only automatic restoration attempt.
acquire_watchdog_lock() {
  local deadline=$(( $(now_epoch) + WATCHDOG_LOCK_SECONDS ))
  mkdir -p "$STATE_DIR"
  exec 9>"$STATE_DIR/.lock"
  until flock -w 1 9; do
    (( $(now_epoch) < deadline )) || die "state lock stayed busy; recovery record retained; run omarchy-candela revert"
  done
}

run_bounded() { timeout --kill-after=1 --signal=TERM "$COMMAND_SECONDS" "$@"; }
run_apply_bounded() { timeout --kill-after=1 --signal=TERM "$APPLY_SECONDS" "$@"; }

read_json_arg() {
  local arg="${1:-}"
  if [[ -z $arg || $arg == "-" ]]; then
    cat
  elif [[ $arg == @* ]]; then
    cat "${arg#@}"
  else
    printf '%s' "$arg"
  fi
}

# Hyprland 0.56.2 reports a mirror by the mirrored output's id ("0"), not
# its name (HyprCtl.cpp; seen on the desk 5 October 2026). Intent, rules and
# the panel all name outputs, so the id becomes a name wherever the list is
# read.
JQ_MIRROR_NAMES='. as $all | map((.mirrorOf // "none" | tostring) as $of | .mirrorOf = (if $of == "none" then "none"
  else ([$all[] | select((.id | tostring) == $of)][0].name // $of) end))'

# Hyprland adds a headless output named FALLBACK when the last real display
# goes away or is switched off, so that it has something to render to. It is
# not a display anyone can see: counted as one, it would make "every display
# is off" look false in exactly the case recover exists for.
live_json() {
  local raw
  raw="$(run_bounded hyprctl monitors all -j 2>/dev/null)" || die "hyprctl is not answering within ${COMMAND_SECONDS}s"
  jq -c "$JQ_MIRROR_NAMES"' | map(select(.name != "FALLBACK"))' <<<"$raw"
}

# Open numbered workspaces and where they are. Special workspaces have
# negative ids and are never planned.
workspaces_json() {
  local out
  out="$(run_bounded hyprctl workspaces -j 2>/dev/null)" || { echo '[]'; return 0; }
  jq -c '[ .[] | select(.id > 0) | {id, name, monitor, windows} ]' <<<"$out" 2>/dev/null || echo '[]'
}

intent_json() {
  if [[ -s $INTENT_FILE ]]; then cat "$INTENT_FILE"; else echo '{"version":1,"displays":{},"global":{}}'; fi
}

pending_json() {
  if [[ -s $PENDING_FILE ]]; then cat "$PENDING_FILE"; else echo 'null'; fi
}

# A recovery baseline is compositor observation, rather than Candela's saved
# overrides.  It is deliberately limited to fields with faithful readback.
observed_intent() {
  local live="$1" auto
  auto="$(run_bounded hyprctl getoption render:cm_auto_hdr -j 2>/dev/null | jq '.int // null' 2>/dev/null || echo null)"
  jq -n --argjson live "$live" --argjson auto "$auto" '
    def r2: (. * 100 | round) / 100;
    def depth: if test("2101010") then 10 elif test("16161616") then 16 else 8 end;
    {version:1, displays: ($live | map({key:.name, value:{
      enabled:(.disabled != true), mode:(if .width > 0 then "\(.width)x\(.height)@\(.refreshRate|r2)" else "preferred" end),
      position:"\(.x)x\(.y)", scale:.scale, transform:(.transform // 0),
      mirror:(if (.mirrorOf // "none") == "none" then "" else .mirrorOf end),
      bitdepth:(.currentFormat // "" | depth), cm:(.colorManagementPreset // "srgb"),
      sdrbrightness:(.sdrBrightness // 1), sdrsaturation:(.sdrSaturation // 1),
      sdr_min_luminance:(.sdrMinLuminance // 0.005), sdr_max_luminance:(.sdrMaxLuminance // 80)
    }}) | from_entries), global:(if $auto == null then {} else {cm_auto_hdr:$auto} end)}'
}

restore_observed() {
  local baseline="$1" live chunk err
  live="$(live_json)"
  chunk="$(generate_lua "$baseline" "$live" "recovery baseline" "" live)"
  run_apply_bounded hyprctl reload >/dev/null 2>&1 || { printf 'Hyprland reload failed'; return 1; }
  err="$(apply_live "$chunk")" || { printf 'hyprctl rejected the recovery baseline: %s' "$err"; return 1; }
  # A display that has gone since the transaction began cannot be restored
  # live, and its file state is already back; requiring it would make every
  # revert fail until it is plugged in again.
  err="$(verify_live "$baseline" "$(jq -c --argjson live "$live" '[.displays | keys[] | select(. as $n | [$live[].name] | index($n) != null)]' <<<"$baseline")")" || { printf '%s' "$err"; return 1; }
}

focused_name() {
  live_json | jq -r '[.[] | select(.focused == true)][0].name // ""'
}

edid_for() {
  "$EDID_TOOL" "$1" 2>/dev/null || jq -nc --arg connector "$1" '{connector: $connector, available: false}'
}

# Validation and merge of a change into an intent document. Runs in jq so the
# same rules apply to every entry point. Unknown keys are rejected; every
# value is checked against what hl.monitor accepts.
merge_intent() {
  local intent="$1" change="$2"
  jq -n --argjson intent "$intent" --argjson change "$change" --arg vre "$VIRTUAL_RE" '
    def fail(msg): error("invalid change: " + msg);
    def is_name: type == "string" and test("^[A-Za-z0-9._-]+$");
    def check_display(d):
      (d.name // "" | if is_name then . else fail("display name") end) as $name
      | (d | del(.name) | to_entries | map(
          .key as $k | .value as $v
          | if (["mode","position","scale","transform","vrr","enabled","mirror","bitdepth","cm","sdr_eotf","sdrbrightness","sdrsaturation","sdr_min_luminance","min_luminance","sdr_max_luminance","max_luminance","max_avg_luminance","icc","supports_hdr","supports_wide_color"] | index($k)) == null then fail("unknown key " + $k)
            elif $v == null then {key: $k, value: null}
            elif $k == "mode" then (if ($v|type)=="string" and ($v|test("^(preferred|highres|highrr|[0-9]+x[0-9]+(@[0-9]+(\\.[0-9]+)?)?)$")) then . else fail("mode") end)
            elif $k == "position" then (if ($v|type)=="string" and ($v|test("^(auto|auto-(left|right|up|down)|-?[0-9]+x-?[0-9]+)$")) then . else fail("position") end)
            elif $k == "scale" then (if (($v|type)=="number" and $v > 0 and $v <= 10) or $v == "auto" then . else fail("scale") end)
            elif $k == "transform" then (if ($v|type)=="number" and ($v|floor)==$v and $v >= 0 and $v <= 7 then . else fail("transform") end)
            elif $k == "vrr" then (if ($v|type)=="number" and ($v|floor)==$v and $v >= -1 and $v <= 3 then . else fail("vrr") end)
            elif $k == "enabled" then (if ($v|type)=="boolean" then . else fail("enabled") end)
            elif $k == "mirror" then (if ($v|type)=="string" and ($v == "" or ($v|is_name)) then . else fail("mirror") end)
            elif $k == "bitdepth" then (if $v == 8 or $v == 10 then . else fail("bitdepth") end)
            elif $k == "cm" then (if ($v|type)=="string" and (["auto","srgb","dcip3","dp3","adobe","wide","edid","hdr","hdredid"] | index($v)) != null then . else fail("cm") end)
            elif $k == "sdr_eotf" then (if ($v|type)=="string" and (["default","gamma22","srgb"] | index($v)) != null then . else fail("sdr_eotf") end)
            elif ($k == "sdrbrightness" or $k == "sdrsaturation") then (if ($v|type)=="number" and $v >= 0 and $v <= 4 then . else fail($k) end)
            elif ($k == "sdr_min_luminance" or $k == "min_luminance") then (if ($v|type)=="number" and $v >= 0 and $v <= 100 then . else fail($k) end)
            elif ($k == "sdr_max_luminance" or $k == "max_luminance" or $k == "max_avg_luminance") then (if ($v|type)=="number" and $v >= 0 and $v <= 10000 then . else fail($k) end)
            elif $k == "icc" then (if ($v|type)=="string" and ($v|test("]==]")|not) and ($v|test("\n")|not) then . else fail("icc") end)
            elif ($k == "supports_hdr" or $k == "supports_wide_color") then (if $v == -1 or $v == 0 or $v == 1 then . else fail($k) end)
            else fail("unknown key " + $k) end
        ) | from_entries) as $fields
      # A virtual display has no panel: it is SDR, since nothing that shows
      # it (VNC, the preview window, a call) carries HDR or wide colour, and
      # it cannot mirror or be mirrored into a capture. Only its geometry.
      | (if ($name | test($vre)) then
           (($fields | keys) - ["mode","position","scale","transform","enabled"] | first) as $k
           | if $k != null then fail($name + " is a virtual display: it is SDR, since nothing that shows it carries HDR or wide colour, so " + $k + " cannot be set; only its size, refresh, scale, rotation, position and whether it is on")
             else . end
         else . end)
      | {name: $name, fields: $fields};
    def check_global(g):
      (g // {}) | to_entries | map(
        .key as $k | .value as $v
        | if $k != "cm_auto_hdr" then fail("unknown global " + $k)
          elif $v == null then .
          elif $k == "cm_auto_hdr" then (if $v == 0 or $v == 1 or $v == 2 then . else fail("cm_auto_hdr") end)
          else fail("unknown global " + $k) end
      ) | from_entries;
    # A colour state Hyprland cannot actually show: an ICC transform only
    # applies outside HDR, and a display whose HDR capability is forced off
    # cannot be asked to render HDR. supports_hdr follows the Hyprland
    # convention: -1 forces it off, 0 is auto/EDID (the default), 1 forces it
    # on. Checked on the MERGED display (existing intent + this change,
    # nulls already stripped), not just the incoming fields, so setting one
    # half now and the other half earlier still trips.
    def check_colour(d):
      ((d.cm // "") as $cm | $cm == "hdr" or $cm == "hdredid") as $hdr_cm
      | if ($hdr_cm and ((d.icc // "") | length > 0)) then fail("hdr is unavailable while an ICC profile is set")
        elif ($hdr_cm and d.supports_hdr == -1) then fail("hdr is unavailable while the HDR capability is forced off")
        else d end;
    # The workspace plan: homes maps workspace 1..10 to a display, shows maps
    # a display to the workspace it shows when it lights up. null removes an
    # entry; the whole block as null turns the plan off.
    def is_workspace: type == "string" and test("^([1-9]|10)$");
    def check_workspaces(w):
      if w == null then null
      elif (w | type) != "object" then fail("workspaces must be an object or null")
      else
        ((w | keys) - ["homes","shows"] | first) as $u
        | if $u != null then fail("unknown workspaces key " + $u) else . end
        | if ((w.homes // {}) | type) != "object" or ((w.shows // {}) | type) != "object" then fail("workspaces homes and shows must be objects") else . end
        | ((w.homes // {}) | to_entries | map(
            if (.key | is_workspace | not) then fail("workspace " + .key + ": homes are workspaces 1 to 10")
            elif .value == null then .
            elif (.value | is_name | not) or .value == "FALLBACK" then fail("workspace " + .key + ": home display name")
            else . end)) as $h
        | ((w.shows // {}) | to_entries | map(
            if (.key | is_name | not) or .key == "FALLBACK" then fail("shows: display name")
            elif .value == null then .
            elif (.value | is_workspace | not) then fail("shows " + .key + ": a workspace from 1 to 10")
            else . end)) as $s
        | w
      end;
    # A display shows a workspace only while that workspace lives there, so a
    # home that moves away takes the display'"'"'s choice with it. No homes left
    # is the plan switched off.
    def merge_workspaces($old; $new):
      if $new == null then null
      else
        ((($old.homes // {}) + ($new.homes // {})) | with_entries(select(.value != null))) as $homes
        | ((($old.shows // {}) + ($new.shows // {})) | with_entries(select(.value != null and $homes[.value] == .key))) as $shows
        | if ($homes | length) == 0 then null
          else {homes: $homes} + (if ($shows | length) > 0 then {shows: $shows} else {} end) end
      end;
    # Unknown top-level keys (a typo, a stray field) currently apply as a
    # silent no-op that still arms a revert timer; reject them, and reject a
    # change carrying none of the keys this tool understands.
    def check_top:
      ($change | keys) as $top
      | (($top - ["displays","global","workspaces"]) | first) as $unknown
      | if $unknown != null then fail("unknown top-level key " + $unknown)
        elif ($top | length) == 0 then fail("nothing to apply")
        else true end;
    check_top as $ok
    | ($change.displays // []) | map(check_display(.)) as $checked
    | check_global($change.global) as $g
    | (if $change | has("workspaces") then check_workspaces($change.workspaces) else null end) as $w
    | reduce $checked[] as $c ($intent;
        . as $acc
        | ((($acc.displays[$c.name] // {}) + $c.fields | with_entries(select(.value != null))) | check_colour(.)) as $merged
        | $acc | .displays[$c.name] = $merged)
    | .global = ((.global // {}) + $g | with_entries(select(.value != null)))
    | if $change | has("workspaces") then
        merge_workspaces(.workspaces; $w) as $plan
        | if $plan == null then del(.workspaces) else .workspaces = $plan end
      else . end
    | .version = 1
  ' 2>&1 || return 1
}

# A display being switched off keeps its rule, so that it comes back where it
# was: record the live mode, position, scale and rotation into intent at the
# moment it goes off, unless intent already says. Without this a re-enabled
# display is generated from its live geometry, which for an off display is
# 0x0 at "preferred", on top of whatever sits at the origin.
remember_geometry() {
  local merged="$1" live="$2" change="$3"
  jq -n --argjson merged "$merged" --argjson live "$live" --argjson change "$change" '
    def r2: (. * 100 | round) / 100;
    reduce ($change.displays // [] | .[] | select(.enabled == false) | .name) as $n ($merged;
      ([$live[] | select(.name == $n and .disabled != true and .width > 0)][0]) as $d
      | if $d == null then . else
          .displays[$n] |= (. + {
            mode: (.mode // "\($d.width)x\($d.height)@\($d.refreshRate | r2)"),
            position: (.position // "\($d.x)x\($d.y)"),
            scale: (.scale // $d.scale),
            transform: (.transform // $d.transform) })
        end)'
}

# Refuse a change that would leave nothing to draw on. The popup and studio
# enforce this too; the CLI must not be the door that gets round it.
check_some_display_stays_on() {
  local intent="$1" live="$2"
  # A virtual display is nowhere anyone can read without a viewer, so it
  # does not count as one that stays on.
  jq -e -n --argjson intent "$intent" --argjson live "$live" --arg vre "$VIRTUAL_RE" '
    [ $live[] | select((.name // "") != "" and (.name | test($vre) | not))
      | ($intent.displays[.name] // {}) as $i
      | if $i.enabled == false then false elif $i.enabled == true then true else (.disabled != true) end ]
    | any' >/dev/null 2>&1 || die "refusing to switch off the last enabled display"
}

# The named workspace each virtual display opens on: its label as a slug,
# or its own name when the label gives nothing usable or two labels clash.
JQ_VIRTUAL_DEFS='
  def virtual_workspace_names($v):
    ($v // {}) | to_entries
    | map(. + {slug: ((.value.label // "") | ascii_downcase | gsub("[^a-z0-9]+"; "-") | gsub("^-+|-+$"; ""))})
    | (map(.slug) | group_by(.) | map(select(length > 1) | .[0])) as $dupes
    | map(.slug as $s | {key, value: (if $s == "" or ($dupes | index($s)) != null then (.key | ascii_downcase) else $s end)})
    | from_entries;
'

# A mirror shows another display's picture, so it cannot be where a workspace
# lives. Checked against the merged intent and, for displays it does not
# mention, what the compositor is doing now.
check_workspace_homes() {
  local intent="$1" live="$2" err
  err="$(jq -r -n --argjson intent "$intent" --argjson live "$live" '
    [ ($intent.workspaces.homes // {}) | to_entries[] | .key as $w | .value as $n
      | ([$live[] | select(.name == $n)][0]) as $d
      | (($intent.displays[$n] // {}).mirror // (if $d == null or ($d.mirrorOf // "none") == "none" then "" else $d.mirrorOf end)) as $m
      | select($m != "")
      | "\($n) mirrors \($m), so it cannot be the home of workspace \($w)" ] | first // ""')"
  [[ -z $err ]] || die "$err"
}

# Lua generation from intent + live geometry. Every connected, enabled display
# gets a full rule so nothing falls back to Hyprland's auto placement. Values
# were validated on the way into intent, so they are emitted verbatim.
#
# $5 selects the audience: "live" is the chunk sent to `hyprctl eval` and says
# everything, including a laptop panel going off; "file" (default) is what is
# written to disk, where a built-in panel's off state is Omarchy's flag file,
# not a rule of ours (see the header). $4 is a probe token: the file sets a
# global to it so a later `hyprctl eval` can prove the file actually ran.
#
# A display that is not connected keeps the rule the kept file last gave it,
# word for word: a change cannot name a display that is not there, so that
# rule is still what was chosen, and dropping it would bring the display back
# at Hyprland's defaults (and an HDR panel back in SDR).
#
# The workspace plan follows the monitor rules. Each rule names its workspace
# the way Omarchy's layout toggle does ("3"), because Hyprland merges rules
# with the same workspace text field by field: Omarchy's layout and our
# display then live in one rule, and neither undoes the other.
generate_lua() {
  local intent="$1" live="$2" stamp="${3:-$(date --iso-8601=seconds)}" probe="${4:-}" audience="${5:-file}" previous=""
  [[ $audience == file && -f $LUA_FILE ]] && previous="$(cat "$LUA_FILE")"
  jq -r -n --argjson intent "$intent" --argjson live "$live" --arg stamp "$stamp" --arg plugin "$PLUGIN_ID" \
        --arg probe "$probe" --arg audience "$audience" --arg internal_re "$INTERNAL_RE" --arg previous "$previous" --arg vre "$VIRTUAL_RE" "$JQ_VIRTUAL_DEFS"'
    def lua_str: "\"" + (tostring | gsub("\\\\"; "\\\\\\\\") | gsub("\""; "\\\"")) + "\"";
    def lua_val($k): if $k == "icc" then "[==[" + tostring + "]==]" elif type == "string" then lua_str else tostring end;
    def r2: (. * 100 | round) / 100;
    def mode_of($d): if ($d.width // 0) > 0 then "\($d.width)x\($d.height)@\($d.refreshRate | r2)" else "preferred" end;
    # An off display with no say from intent is left to whatever switched it
    # off, except that the file names the built-in panel'"'"'s owner so the
    # rule'"'"'s absence is not a mystery to a reader.
    def rule($d):
      ($intent.displays[$d.name] // {}) as $i
      | ($d.name | test($internal_re)) as $internal
      | if $i.enabled == false or ($d.disabled == true and $i.enabled != true) then
          if $audience == "file" and $internal then
            "-- \($d.name) is off. The built-in panel'"'"'s off state is Omarchy'"'"'s internal-monitor-disable toggle, which its clamshell script honours; this file never carries a rule for it."
          elif $i.enabled == false then
            "hl.monitor({ output = \($d.name | lua_str), disabled = true })"
          else
            ""
          end
        else
          # hl.monitor starts from the earlier rule for the output and keeps
          # every field this one leaves out (Hyprland 0.56.2,
          # LuaBindingsConfigRules.cpp; seen on the desk 5 October 2026). A
          # display switched off would stay off, and a mirror stay a mirror,
          # unless the rule says otherwise: so it always says it is on, and
          # says "no mirror" whenever intent does.
          ([ "output = \($d.name | lua_str)",
             "disabled = false",
             "mode = \(($i.mode // mode_of($d)) | lua_str)",
             "position = \(($i.position // "\($d.x)x\($d.y)") | lua_str)",
             "scale = \(($i.scale // $d.scale) | lua_val("scale"))",
             "transform = \(($i.transform // $d.transform // 0) | tostring)" ]
           + ([ "vrr","mirror","bitdepth","cm","sdr_eotf","sdrbrightness","sdrsaturation",
                "sdr_min_luminance","sdr_max_luminance","min_luminance","max_luminance","max_avg_luminance",
                "icc","supports_hdr","supports_wide_color" ]
              | map(. as $k | select($i[$k] != null and ($k != "icc" or $i[$k] != "")) | "\($k) = \($i[$k] | lua_val($k))")))
          | "hl.monitor({ " + join(", ") + " })"
        end;
    def carried:
      [ $previous | split("\n")[]
        | select(test("^hl\\.monitor\\(\\{ output = \""))
        | (capture("^hl\\.monitor\\(\\{ output = \"(?<n>[^\"]+)\"").n) as $n
        | select([$live[].name] | index($n) == null)
        # A virtual display is never unplugged: if intent no longer has it,
        # it was removed, and its rule goes with it.
        | select($n | test($vre) | not) ];
    # A virtual display that is not created yet (at login, before the service
    # creates it; during `virtual add`) gets its rule from intent, so the
    # output lands where it should the moment it exists.
    def virtual_not_created:
      [ ($intent.virtual // {}) | keys[] | select(. as $n | [$live[].name] | index($n) == null)
        | . as $n | ($intent.displays[$n] // {}) as $i
        | "hl.monitor({ output = \($n | lua_str), disabled = \($i.enabled == false), mode = \(($i.mode // "1920x1080@60") | lua_str), position = \(($i.position // "auto") | lua_str), scale = \(($i.scale // 1) | lua_val("scale")), transform = \(($i.transform // 0) | tostring) })" ];
    # Each virtual display opens on a named workspace of its own (ids below
    # -1337), so it never takes one of workspaces 1 to 10.
    def virtual_workspace_rules:
      (virtual_workspace_names($intent.virtual) | to_entries) as $v
      | if ($v | length) == 0 then []
        else [ "", "-- Each virtual display opens on a named workspace of its own, so workspaces 1 to 10 stay yours." ]
          + [ $v[] | "hl.workspace_rule({ workspace = \(("name:" + .value) | lua_str), monitor = \(.key | lua_str), default = true })" ]
        end;
    def workspace_rules:
      ($intent.workspaces.homes // {}) as $homes
      | ($intent.workspaces.shows // {}) as $explicit
      # Each display shows its chosen workspace, else its lowest-numbered one.
      | ($homes | to_entries | group_by(.value)
          | map({key: .[0].value, value: (map(.key | tonumber) | min | tostring)}) | from_entries
          | with_entries(.key as $n | .value = (if ($explicit[$n] // null) != null and $homes[$explicit[$n]] == $n then $explicit[$n] else .value end))) as $shows
      | if ($homes | length) == 0 then []
        else
          [ "", "-- Workspace homes. Omarchy'"'"'s per-workspace layout rules use the same workspace text and merge into these." ]
          + [ range(1; 11) | tostring as $w | select($homes[$w] != null)
              | "hl.workspace_rule({ workspace = \($w | lua_str), monitor = \($homes[$w] | lua_str)"
                + (if $shows[$homes[$w]] == $w then ", default = true" else "" end) + " })" ]
        end;
    [ "-- Generated by \($plugin) (omarchy-candela). Do not edit: it is rewritten on every keep.",
      "-- Kept \($stamp). Change displays with the Candela panel or `omarchy-candela`.",
      "" ]
    + [ $live[] | select((.name // "") != "") | rule(.) | select(. != "") ]
    + (if $audience == "file" then carried as $c | if ($c | length) > 0 then ["", "-- Not connected now. Kept as last written, so it comes back the same way."] + $c else [] end else [] end)
    + (if $audience == "file" then virtual_not_created as $c | if ($c | length) > 0 then ["", "-- Virtual, created by the Candela service when the shell starts."] + $c else [] end else [] end)
    + workspace_rules
    + virtual_workspace_rules
    + (if ($intent.global.cm_auto_hdr != null) then ["", "hl.config({ render = { cm_auto_hdr = \($intent.global.cm_auto_hdr) } })"] else [] end)
    + (if $probe != "" then ["", "-- Load probe: `omarchy-candela doctor` asks Hyprland whether this value is set.", "omarchy_candela_layout_probe = \($probe | lua_str)"] else [] end)
    | join("\n")
  '
}

# Live apply sends only statements: hyprctl parses a leading "--" as one of
# its own flags, so the file header must never reach `hyprctl eval`. Reports
# failure through stdout + exit status instead of calling die() directly, so
# the caller can unwind the pending change before the process exits.
apply_live() {
  local chunk statements output
  chunk="$1"
  statements="$(printf '%s\n' "$chunk" | grep -vE '^[[:space:]]*(--|$)')"
  [[ -n $statements ]] || return 0
  output="$(run_apply_bounded hyprctl eval "$statements" 2>&1)" || { printf '%s' "$output"; return 1; }
  if [[ $output != ok* ]]; then printf '%s' "$output"; return 1; fi
}

# Read the compositor back until it matches the intent, or give up after
# VERIFY_SECONDS. Hyprland can accept a chunk and still land elsewhere (a mode
# it quietly falls back from, a scale it corrects); "ok" from eval is not the
# same as the change being on the glass. Prints the mismatches on failure.
# Only fields the intent names are compared, and only ones hyprctl reports
# faithfully: position and mode are skipped on a mirror, cm only for presets
# Hyprland echoes back verbatim, scale to hyprctl's two decimals.
verify_live() {
  local intent="$1" required="${2:-[]}" deadline mismatch live
  deadline=$(( $(now_ms) + $(awk -v s="$VERIFY_SECONDS" 'BEGIN { printf "%d", s * 1000 }') ))
  while :; do
    # Measured on the desk (9 September 2026): the eval returns in ~5 ms and
    # the modeset shows up as the next readback blocking 0.2-0.4 s. A poll
    # that times out during a slower modeset is retried until the deadline.
    if ! live="$(run_bounded hyprctl monitors all -j 2>/dev/null)" || ! live="$(jq -c "$JQ_MIRROR_NAMES" <<<"$live" 2>/dev/null)"; then
      (( $(now_ms) >= deadline )) && { printf 'hyprctl is not answering'; return 1; }
      sleep 0.2; continue
    fi
    mismatch="$(jq -r -n --argjson intent "$intent" --argjson live "$live" --argjson required "$required" '
      def depth_of: if test("2101010") then 10 elif test("16161616") then 16 else 8 end;
      def r2: (. * 100 | round) / 100;
      [ ($intent.displays // {}) | to_entries[] | .key as $n | .value as $i
        | ([$live[] | select(.name == $n)][0]) as $d
        | if $d == null and ($required | index($n)) != null then "\($n) is no longer connected"
          elif $d == null then empty
          elif $i.enabled == false then
            (if $d.disabled != true then "\($n) is still on" else empty end)
          elif $d.disabled == true then
            (if $i.enabled == true then "\($n) is still off" else empty end)
          else
            ( if ($i.mirror // "") != "" then
                (if $d.mirrorOf != $i.mirror then "\($n) mirrors \($d.mirrorOf), wanted \($i.mirror)" else empty end)
              else
                (if $i.mirror == "" and $d.mirrorOf != "none" and $d.mirrorOf != null then "\($n) still mirrors \($d.mirrorOf)" else empty end),
                (if ($i.mode // "" | test("^[0-9]+x[0-9]+")) then
                    ($i.mode | capture("^(?<w>[0-9]+)x(?<h>[0-9]+)(@(?<r>[0-9.]+))?")) as $m
                    | (if $d.width != ($m.w | tonumber) or $d.height != ($m.h | tonumber) then "\($n) mode \($d.width)x\($d.height), wanted \($m.w)x\($m.h)" else empty end),
                      (if $m.r != null and (($d.refreshRate - ($m.r | tonumber)) | fabs) > 0.2 then "\($n) refresh \($d.refreshRate | r2) Hz, wanted \($m.r)" else empty end)
                  else empty end),
                (if ($i.position // "" | test("^-?[0-9]+x-?[0-9]+$")) then
                    ($i.position | capture("^(?<x>-?[0-9]+)x(?<y>-?[0-9]+)$")) as $p
                    | (if $d.x != ($p.x | tonumber) or $d.y != ($p.y | tonumber) then "\($n) at \($d.x)x\($d.y), wanted \($i.position)" else empty end)
                  else empty end),
                (if ($i.scale | type) == "number" and (($d.scale - $i.scale) | fabs) > 0.006 then "\($n) scale \($d.scale), wanted \($i.scale)" else empty end),
                (if $i.transform != null and $d.transform != $i.transform then "\($n) transform \($d.transform), wanted \($i.transform)" else empty end)
              end ),
            (if $i.bitdepth != null and ($d.currentFormat // "" | depth_of) != $i.bitdepth then "\($n) is \($d.currentFormat // "" | depth_of)-bit, wanted \($i.bitdepth)" else empty end),
            (if ($i.cm // "" | IN("srgb", "hdr", "hdredid")) and $d.colorManagementPreset != $i.cm then "\($n) colour preset \($d.colorManagementPreset), wanted \($i.cm)" else empty end),
            (if $i.sdr_max_luminance != null and (($d.sdrMaxLuminance // 0) | round) != ($i.sdr_max_luminance | round) then "\($n) SDR white \($d.sdrMaxLuminance) cd/m², wanted \($i.sdr_max_luminance)" else empty end)
          end
      ] | join("; ")')"
    [[ -n $mismatch ]] || return 0
    (( $(now_ms) >= deadline )) && break
    sleep 0.2
  done
  printf '%s' "$mismatch"
  return 1
}

# Did the layout file run on the last reload? It sets a global to the probe
# written into it; asking Hyprland for that global is the only proof that the
# toggles directory is still being loaded.
probe_loaded() {
  local out
  out="$(run_bounded hyprctl eval "assert(omarchy_candela_layout_probe == \"$1\", \"candela-layout.lua did not run\")" 2>&1)" || return 1
  [[ $out == ok* ]]
}

# ---------------------------------------------------------------- workspaces
#
# A reload never moves a workspace that is already open: rules only decide
# where a workspace is created, and where it goes when a display connects. So
# a change to the plan moves the open ones itself. Moving the workspace on
# screen takes focus and the pointer with it, so that one goes last.

# Moves as "id<TAB>display" lines: open workspaces 1..10 that are away from
# a home that is connected, on and not a mirror.
workspace_moves() {
  local intent="$1" live="$2" open="$3" active="$4"
  jq -r -n --argjson intent "$intent" --argjson live "$live" --argjson open "$open" --arg active "$active" '
    ($intent.workspaces.homes // {}) as $homes
    | [ $live[] | select(.disabled != true and (.mirrorOf // "none") == "none") | .name ] as $usable
    | [ $open[] | select(.id >= 1 and .id <= 10)
        | ($homes[(.id | tostring)] // null) as $home
        | select($home != null and ($usable | index($home)) != null and .monitor != $home)
        | {id, to: $home} ]
    | sort_by(if (.id | tostring) == $active then 1 else 0 end)
    | .[] | "\(.id)\t\(.to)"'
}

dispatch_move() {
  local id="$1" to="$2" out
  out="$(run_bounded hyprctl dispatch "hl.dsp.workspace.move({ workspace = \"$id\", monitor = \"$to\" })" 2>&1)" || { printf 'workspace %s: %s' "$id" "${out:-hyprctl failed}"; return 1; }
  [[ $out == ok* ]] || { printf 'workspace %s: %s' "$id" "$out"; return 1; }
}

active_workspace_id() {
  run_bounded hyprctl activeworkspace -j 2>/dev/null | jq -r '.id // ""' 2>/dev/null || true
}

# Wait until every "id<TAB>display" line in $1 holds, or say which did not.
verify_workspaces_placed() {
  local wanted="$1" deadline open missing
  [[ -n $wanted ]] || return 0
  deadline=$(( $(now_ms) + $(awk -v s="$VERIFY_SECONDS" 'BEGIN { printf "%d", s * 1000 }') ))
  while :; do
    open="$(workspaces_json)"
    missing="$(jq -r -n --argjson open "$open" --arg wanted "$wanted" '
      [ $wanted | split("\n")[] | select(. != "") | split("\t") as [$id, $to]
        | ([$open[] | select((.id | tostring) == $id)][0]) as $w
        | select($w != null and $w.monitor != $to)
        | "workspace \($id) is on \($w.monitor), wanted \($to)" ] | join("; ")')"
    [[ -n $missing ]] || return 0
    (( $(now_ms) >= deadline )) && break
    sleep 0.2
  done
  printf '%s' "$missing"
  return 1
}

# Send the open workspaces home under $1's plan. Prints what failed.
move_workspaces_home() {
  local intent="$1" live moves line err=""
  live="$(live_json)"
  moves="$(workspace_moves "$intent" "$live" "$(workspaces_json)" "$(active_workspace_id)")"
  while IFS=$'\t' read -r id to; do
    [[ -n $id ]] || continue
    line="$(dispatch_move "$id" "$to")" || err="${err:+$err; }$line"
  done <<<"$moves"
  [[ -z $err ]] || { printf '%s' "$err"; return 1; }
  verify_workspaces_placed "$moves"
}

# Put open workspaces back where $1 (a workspaces_json snapshot) had them.
# A workspace closed since, or whose display has gone, is left alone, the way
# a revert leaves a display that has been unplugged. Best effort: a workspace
# that will not move is reported, never a reason to abandon the revert.
restore_workspaces() {
  local before="$1" live moves id to line err=""
  [[ -n $before && $before != null && $before != "[]" ]] || return 0
  live="$(live_json)"
  moves="$(jq -r -n --argjson before "$before" --argjson live "$live" --argjson open "$(workspaces_json)" --arg active "$(active_workspace_id)" '
    [ $live[] | select(.disabled != true and (.mirrorOf // "none") == "none") | .name ] as $usable
    | [ $before[] | . as $b
        | ([$open[] | select(.id == $b.id)][0]) as $now
        | select($now != null and $now.monitor != $b.monitor and ($usable | index($b.monitor)) != null)
        | {id, to: .monitor} ]
    | sort_by(if (.id | tostring) == $active then 1 else 0 end)
    | .[] | "\(.id)\t\(.to)"')"
  while IFS=$'\t' read -r id to; do
    [[ -n $id ]] || continue
    line="$(dispatch_move "$id" "$to")" || err="${err:+$err; }$line"
  done <<<"$moves"
  [[ -z $err ]] || echo "omarchy-candela: could not put every workspace back: $err" >&2
  return 0
}

# After a reload: does every planned workspace's live rule name its home?
# Omarchy's layout rules merge into ours, so only the monitor is compared.
verify_workspace_rules() {
  local intent="$1" rules out
  [[ $(jq -r '(.workspaces.homes // {}) | length' <<<"$intent") != 0 ]] || return 0
  rules="$(run_bounded hyprctl workspacerules -j 2>/dev/null)" || { printf 'hyprctl workspacerules is not answering'; return 1; }
  out="$(jq -r -n --argjson intent "$intent" --argjson rules "$rules" '
    [ $intent.workspaces.homes | to_entries[] | .key as $w | .value as $n
      | ([$rules[] | select(.workspaceString == $w and .enabled != false)] | map(.monitor // "") | last // "") as $m
      | select($m != $n)
      | if $m == "" then "workspace \($w) has no home rule" else "workspace \($w) lives on \($m), wanted \($n)" end ]
    | join("; ")')"
  [[ -z $out ]] || { printf '%s' "$out"; return 1; }
}

stop_timer() {
  run_bounded systemctl --user stop "$REVERT_UNIT.timer" "$REVERT_UNIT.service" >/dev/null 2>&1 || true
}

start_timer() {
  local token="$1"
  stop_timer
  run_bounded systemd-run --user --quiet --collect --unit="$REVERT_UNIT" \
    --on-active="${REVERT_SECONDS}s" --timer-property=AccuracySec=200ms \
    -- "$SELF" revert --expired --token "$token" >/dev/null 2>&1 || {
    # No systemd user manager (tests, odd sessions): fall back to a detached
    # shell. It must drop fd 9 (acquire_lock's flock) first: it outlives this
    # process for the whole revert window and would otherwise hold the state
    # lock the entire time, blocking an interactive keep/apply/revert.
    (setsid bash -c "exec 9>&-; sleep $REVERT_SECONDS; '$SELF' revert --expired --token '$token'" >/dev/null 2>&1 &)
  }
}

notify_shell() {
  run_bounded omarchy-shell -q "$PLUGIN_ID" refresh 2>/dev/null || true
}

# A temp file beside $1, not a fixed name, so two concurrent writers cannot
# clobber each other's temp file. Caller does `cmd > "$tmp" && mv "$tmp" "$1"`.
tmp_for() { mktemp "$(dirname "$1")/.$(basename "$1").XXXXXX"; }

snapshot_files() {
  local out='{}' key path present content
  while (( $# >= 2 )); do
    key="$1"; path="$2"; shift 2
    if [[ -f $path ]]; then present=true; content="$(base64 -w0 "$path")"; else present=false; content=""; fi
    out="$(jq -c --arg k "$key" --arg p "$path" --argjson present "$present" --arg content "$content" '.+{($k):{path:$p,present:$present,contentBase64:$content}}' <<<"$out")"
  done
  printf '%s' "$out"
}

restore_files() {
  local snaps="$1" key path present tmp status=0
  while IFS= read -r key; do
    path="$(jq -r --arg k "$key" '.[$k].path' <<<"$snaps")"
    present="$(jq -r --arg k "$key" '.[$k].present' <<<"$snaps")"
    if [[ $present == true ]]; then
      mkdir -p "$(dirname "$path")" || { status=1; continue; }
      tmp="$(tmp_for "$path")" || { status=1; continue; }
      if ! jq -r --arg k "$key" '.[$k].contentBase64' <<<"$snaps" | base64 -d > "$tmp" || ! mv "$tmp" "$path"; then
        rm -f -- "$tmp"; status=1
      fi
    else
      rm -f -- "$path" || status=1
    fi
  done < <(jq -r 'keys[]' <<<"$snaps")
  return "$status"
}

# ---------------------------------------------------------------- built-in panel
#
# The built-in panel's off state is Omarchy's flag file, and a change that
# touches it records what the flag looked like before, so revert can put it
# back. One panel per machine, so one flag.

# What this change says about the built-in panel: "off", "on", or "" for nothing.
internal_verdict() {
  jq -r --arg re "$INTERNAL_RE" '
    [ .displays // [] | .[] | select(.name | test($re)) | select(has("enabled")) | .enabled ]
    | if length == 0 then "" elif .[-1] == false then "off" else "on" end' <<<"$1"
}

internal_name_in() {
  jq -r --arg re "$INTERNAL_RE" '[ .displays // [] | .[] | select(.name | test($re)) | select(has("enabled")) | .name ] | last // ""' <<<"$1"
}



# Same content Omarchy's own `omarchy-hyprland-monitor-internal off` writes.
apply_internal_verdict() {
  local verdict="$1" name="$2"
  case "$verdict" in
    off) mkdir -p "$TOGGLES_DIR"; printf 'hl.monitor({ output = "%s", disabled = true })\n' "$name" > "$INTERNAL_FLAG" ;;
    on) rm -f "$INTERNAL_FLAG" ;;
  esac
}

# The flag is the source of truth for the panel's off state, so intent never
# stores "enabled" for it: a stale value there would fight Omarchy's own
# toggle on the next keep.
strip_internal_enabled() {
  jq --arg re "$INTERNAL_RE" '.displays |= with_entries(if (.key | test($re)) then .value |= del(.enabled) else . end)' <<<"$1"
}

# Omarchy's clamshell script restores the panel at the scale in this file when
# it cannot read one from monitors.lua (it never reads our layout), so keep
# it current with what was kept. Only where that script exists.
write_internal_scale() {
  local intent="$1" live="$2" scale
  command -v omarchy-hyprland-monitor-clamshell >/dev/null 2>&1 || return 0
  scale="$(jq -r -n --argjson intent "$intent" --argjson live "$live" --arg re "$INTERNAL_RE" '
    ([$live[] | select(.name | test($re))][0]) as $d
    | if $d == null then "" else (($intent.displays[$d.name] // {}).scale // (if $d.disabled != true and $d.scale > 0 then $d.scale else "" end)) end
    | if (type == "number") then tostring else "" end')"
  [[ $scale =~ ^[0-9]+([.][0-9]+)?$ ]] || return 0
  mkdir -p "$TOGGLES_DIR"
  printf '%s\n' "$scale" > "$INTERNAL_SCALE_FILE"
}

# ---------------------------------------------------------------- state files

# Undo a pending apply that never fully landed: stop the timer, drop the
# pending files, put Omarchy's flag back, and reload so hyprctl falls back to
# the last kept Lua.
unwind_pending() {
  local baseline=null files='{}' files_err="" live_err="" err ws_before=null
  [[ -s $PENDING_FILE ]] && baseline="$(jq -c '.baseline // null' "$PENDING_FILE")"
  [[ -s $PENDING_FILE ]] && files="$(jq -c '.files // {}' "$PENDING_FILE")"
  [[ -s $PENDING_FILE ]] && ws_before="$(jq -c '.workspacesBefore // null' "$PENDING_FILE")"
  stop_timer
  # Under errexit an unguarded failure here would abort before the record
  # below is written, leaving pending.json claiming a preview is still on.
  restore_files "$files" || files_err="restoring the saved files failed"
  if [[ $baseline == null ]]; then live_err="no recovery baseline"
  elif ! live_err="$(restore_observed "$baseline")"; then live_err="${live_err:-live restoration failed}"; fi
  restore_workspaces "$ws_before"
  if [[ -z $files_err && -z $live_err ]]; then
    rm -f "$PENDING_FILE"
    return 0
  fi
  err="${files_err}${files_err:+${live_err:+; }}${live_err}"
  [[ -s $PENDING_FILE ]] && jq --arg e "$err" '.phase="failed"|.recovery={available:true,error:$e}' "$PENDING_FILE" > "$PENDING_FILE.tmp" && mv "$PENDING_FILE.tmp" "$PENDING_FILE"
  return 1
}

# Reload so Hyprland re-reads the just-written layout, then check for config
# errors, prove the file ran, and read the displays back — the one path both
# `keep` and `apply --now` use, so a bad write is never silently reported as
# kept.
reload_and_check() {
  local intent="$1" probe="${2:-}" required="${3:-[]}" errors mismatch
  run_apply_bounded hyprctl reload >/dev/null 2>&1 || { printf 'Hyprland reload failed'; return 1; }
  if ! errors="$(run_bounded hyprctl configerrors 2>/dev/null)"; then printf 'Hyprland config error query failed'; return 1; fi
  errors="$(grep -v '^ok$' <<<"$errors" || true)"
  notify_shell
  [[ -z $errors ]] || { printf 'Hyprland reports config errors: %s' "$errors"; return 1; }
  if [[ -n $probe ]] && ! probe_loaded "$probe"; then
    printf 'Hyprland did not run %s on reload; omarchy-candela doctor explains' "$LUA_FILE"; return 1
  fi
  if ! mismatch="$(verify_live "$intent" "$required")"; then
    printf 'the compositor did not land on it: %s' "$mismatch"; return 1
  fi
  if ! mismatch="$(verify_workspace_rules "$intent")"; then
    printf 'the workspace plan did not load: %s' "$mismatch"; return 1
  fi
}

LAST_PROBE=""
commit_intent() {
  local intent="$1" live tmp probe
  live="$(live_json)" || return 1
  intent="$(strip_internal_enabled "$intent")" || return 1
  probe="$(now_epoch)-$$-$RANDOM"
  mkdir -p "$STATE_DIR" "$TOGGLES_DIR" || return 1
  tmp="$(tmp_for "$INTENT_FILE")" || return 1
  if ! printf '%s\n' "$intent" | jq . > "$tmp" || ! mv "$tmp" "$INTENT_FILE"; then rm -f -- "$tmp"; return 1; fi
  tmp="$(tmp_for "$LUA_FILE")" || return 1
  if ! generate_lua "$intent" "$live" "" "$probe" file > "$tmp" || ! mv "$tmp" "$LUA_FILE"; then rm -f -- "$tmp"; return 1; fi
  write_internal_scale "$intent" "$live" || return 1
  LAST_PROBE="$probe"
}

# ---------------------------------------------------------------- commands

cmd_state() {
  local live intent pending focused edids brightness auto_hdr sdr_eotf internal_flag
  live="$(live_json)"
  intent="$(intent_json)"
  pending="$(pending_json)"
  focused="$(printf '%s' "$live" | jq -r '[.[] | select(.focused == true)][0].name // ""')"

  edids="{}"
  while IFS= read -r name; do
    [[ -n $name ]] || continue
    edids="$(jq -c --arg n "$name" --argjson e "$(edid_for "$name")" '. + {($n): $e}' <<<"$edids")"
  done < <(printf '%s' "$live" | jq -r '.[].name')

  brightness=""
  [[ -n $focused ]] && brightness="$(omarchy-brightness-display --monitor "$focused" 2>/dev/null || true)"
  auto_hdr="$(run_bounded hyprctl getoption render:cm_auto_hdr -j 2>/dev/null | jq '.int // null' 2>/dev/null || echo null)"
  sdr_eotf="$(run_bounded hyprctl getoption render:cm_sdr_eotf -j 2>/dev/null | jq -r '.str // "default"' 2>/dev/null || echo default)"
  # Hyprland's own animations switch doubles as the reduced-motion preference:
  # someone who turned the compositor's motion off wants the shell's off too.
  animations="$(run_bounded hyprctl getoption animations:enabled -j 2>/dev/null | jq 'if has("bool") then .bool elif has("int") then .int != 0 else null end' 2>/dev/null || echo null)"
  [[ $animations == true || $animations == false ]] || animations=null
  internal_flag=false; [[ -f $INTERNAL_FLAG ]] && internal_flag=true
  local open_ws undo=null
  open_ws="$(workspaces_json)"
  if fresh_undo; then
    undo="$(jq -c --argjson now "$(now_epoch)" --argjson ttl "$UNDO_SECONDS" '{since, what: (.what // "the last change"), remaining: ([.since + $ttl - $now, 0] | max)}' "$UNDO_FILE" 2>/dev/null || echo null)"
  fi
  local virtual
  virtual="$(virtual_state_json "$live" "$intent")"
  jq -n --argjson live "$live" --argjson intent "$intent" --argjson pending "$pending" \
        --argjson openWorkspaces "$open_ws" --argjson workspaceUndo "$undo" --argjson virtual "$virtual" --arg vre "$VIRTUAL_RE" \
        --argjson edids "$edids" --arg focused "$focused" --arg brightness "$brightness" \
        --argjson autoHdr "$auto_hdr" --arg sdrEotf "$sdr_eotf" --arg pluginId "$PLUGIN_ID" \
        --argjson revertSeconds "$REVERT_SECONDS" --argjson now "$(now_epoch)" \
        --argjson internalFlag "$internal_flag" --arg internalRe "$INTERNAL_RE" --arg stateDir "$STATE_DIR" --argjson animations "$animations" '
    def bitdepth_of: if test("2101010") then 10 elif test("16161616") then 16 else 8 end;
    {
      version: 1,
      pluginId: $pluginId,
      now: $now,
      focused: $focused,
      revertSeconds: $revertSeconds,
      animations: $animations,
      pending: (if $pending == null then null else {since:$pending.since,expires:$pending.expires,remaining:([$pending.expires-$now,0]|max),phase:($pending.phase//"previewing"),intent:$pending.intent,baseline:$pending.baseline,targets:($pending.targets//[])} end),
      paths:{stateDir:$stateDir},
      recovery:(if $pending.recovery then ($pending.recovery+{status:$pending.phase,token:$pending.token}) else null end),
      global: { cm_auto_hdr: $autoHdr, cm_sdr_eotf: $sdrEotf, kept: ($intent.global // {}), pending: (($pending.intent.global // {}) ), pendingConfig:(if $pending==null then null else ($pending.intent.global//{}) end), internalPanelOffByOmarchy: $internalFlag },
      workspaces: {
        kept: ($intent.workspaces // null),
        pendingConfig: (if $pending == null then null else ($pending.intent.workspaces // null) end),
        open: $openWorkspaces
      },
      undo: $workspaceUndo,
      virtual: $virtual,
      displays: [ $live[] | {
        name, description, make, model, serial: (.serial | gsub("^\\s+|\\s+$"; "")),
        internal: (.name | test($internalRe)),
        virtual: (.name | test($vre)),
        enabled: (.disabled != true), focused, dpms: .dpmsStatus,
        width, height, refreshRate, x, y, scale, transform, vrr, mirrorOf,
        physicalWidth, physicalHeight, currentFormat, availableModes,
        live: {
          bitdepth: (.currentFormat | bitdepth_of),
          cm: .colorManagementPreset,
          sdrBrightness, sdrSaturation, sdrMinLuminance, sdrMaxLuminance
        },
        capabilities: ($edids[.name] // {connector: .name, available: false}),
        brightness: (if .name == $focused and ($brightness | test("^[0-9]+$")) then ($brightness | tonumber) else null end),
        kept: ($intent.displays[.name] // {}),
        pendingConfig: (($pending.intent.displays // {})[.name] // null)
      } ]
    }'
}

cmd_apply() {
  local now=0
  if [[ ${1:-} == "--now" ]]; then now=1; shift; fi
  local change intent base merged live chunk_live chunk_file baseline previous targets files ws_before ws_change=0 at_once=0
  change="$(read_json_arg "${1:-}")"
  [[ -n $change ]] || die "apply needs a JSON change"
  printf '%s' "$change" | jq -e 'type == "object"' >/dev/null 2>&1 || die "change is not a JSON object"
  targets="$(jq -c '[.displays // [] | .[].name] | unique' <<<"$change")"
  jq -e 'has("workspaces")' <<<"$change" >/dev/null && ws_change=1
  # Neither the workspace plan nor a virtual display can blank a real screen,
  # so a change that touches only those is kept at once; `revert` can still
  # undo it.
  jq -e --arg vre "$VIRTUAL_RE" '(has("global") | not) and (has("displays") or has("workspaces"))
    and ((.displays // []) | all(.name | test($vre)))' <<<"$change" >/dev/null && at_once=1
  (( at_once )) && now=1
  # Any newer change makes that undo meaningless.
  rm -f "$UNDO_FILE"

  # Chain onto a pending change, so successive slider moves accumulate.
  if [[ -s $PENDING_FILE ]]; then
    base="$(jq -c '.intent' "$PENDING_FILE")"
    baseline="$(jq -c '.baseline' "$PENDING_FILE")"
    previous="$(jq -c '.previousIntent' "$PENDING_FILE")"
    files="$(jq -c '.files' "$PENDING_FILE")"
    ws_before="$(jq -c '.workspacesBefore // []' "$PENDING_FILE")"
    # An immediate slider move joins the outstanding preview; it cannot keep
    # unrelated fields that are still waiting for confirmation.
    now=0
  else
    base="$(intent_json)"
    previous="$base"
    files="$(snapshot_files intent "$INTENT_FILE" layout "$LUA_FILE" pendingLua "$PENDING_LUA" internalFlag "$INTERNAL_FLAG" internalScale "$INTERNAL_SCALE_FILE")"
    # Where the open workspaces are before this transaction moves any.
    ws_before="$(workspaces_json)"
  fi
  merged="$(merge_intent "$base" "$change")" || die "${merged#jq: error (at <unknown>): }"
  live="$(live_json)"
  [[ -n ${baseline:-} && $baseline != null ]] || baseline="$(observed_intent "$live")"
  # Every display named by this interactive transaction must still exist.
  local missing
  missing="$(jq -r -n --argjson c "$change" --argjson l "$live" '[($c.displays//[])[].name | select(. as $n | [$l[].name] | index($n) == null)] | join(", ")')"
  [[ -z $missing ]] || die "requested display is not connected: $missing"
  merged="$(remember_geometry "$merged" "$live" "$change")"
  check_some_display_stays_on "$merged" "$live"
  check_workspace_homes "$merged" "$live"
  chunk_live="$(generate_lua "$merged" "$live" "" "" live)"

  local verdict internal
  verdict="$(internal_verdict "$change")"
  internal="$(internal_name_in "$change")"
  # The first change in a chain to touch the panel's flag records what it
  # looked like before; later ones in the same chain keep that original.

  # Pending is written and the timer armed BEFORE the live displays are
  # touched, so a hyprctl rejection partway through, or the process being
  # killed, always leaves a revert ready to unwind whatever did land.
  mkdir -p "$STATE_DIR"
  local token since expires tmp
  token="$(now_epoch)-$$-$RANDOM"
  since="$(now_epoch)"; expires=$(( since + REVERT_SECONDS ))
  tmp="$(tmp_for "$PENDING_FILE")"
  if [[ -s $PENDING_FILE ]]; then targets="$(jq -c --argjson n "$targets" '((.targets//[]) + $n)|unique' "$PENDING_FILE")"; fi
  jq -n --argjson intent "$merged" --argjson baseline "$baseline" --argjson previous "$previous" --argjson targets "$targets" --argjson files "$files" --argjson since "$since" --argjson expires "$expires" --arg token "$token" --argjson wsBefore "$ws_before" \
    '{since:$since, expires:$expires, token:$token, phase:"previewing", intent:$intent, baseline:$baseline, previousIntent:$previous, targets:$targets,files:$files,workspacesBefore:$wsBefore}' > "$tmp" && mv "$tmp" "$PENDING_FILE"
  start_timer "$token"

  if (( ! now )); then
    # The preview on disk, loaded after the layout: a reload from anywhere
    # during the window re-applies it instead of reverting it.
    mkdir -p "$TOGGLES_DIR"
    chunk_file="$(generate_lua "$merged" "$live" "pending since $since; reverts at $expires unless kept" "" file)"
    tmp="$(tmp_for "$PENDING_LUA")"
    printf '%s\n' "$chunk_file" > "$tmp" && mv "$tmp" "$PENDING_LUA"
  fi
  apply_internal_verdict "$verdict" "$internal"

  # A virtual display being switched off loses its viewers first: when its
  # output goes, wayvnc moves on to a real display and keeps serving it.
  local vname
  while IFS= read -r vname; do
    [[ -n $vname ]] && virtual_stop_all "$vname"
  done < <(jq -r --arg vre "$VIRTUAL_RE" '[.displays // [] | .[] | select(.enabled == false) | .name | select(test($vre))] | unique | .[]' <<<"$change")

  local err
  if ! err="$(apply_live "$chunk_live")"; then
    unwind_pending
    die "hyprctl rejected the change: $err"
  fi
  if ! err="$(verify_live "$merged" "$targets")"; then
    unwind_pending
    die "applied, but the compositor did not land on it, so it was undone: $err"
  fi
  # A change to the plan sends the open workspaces home; the rules alone
  # would only place the ones created from now on.
  if (( ws_change )) && ! err="$(move_workspaces_home "$merged")"; then
    unwind_pending
    die "applied, but the workspaces did not move, so it was undone: $err"
  fi

  if (( now )); then
    cmd_keep
    if (( at_once )) && [[ ${CANDELA_NO_UNDO:-} != 1 ]]; then
      write_undo "$previous" "$ws_before" "$(jq -r '
        [ (.displays // [] | map(.name) | unique | if length > 0 then "changing " + join(" and ") else empty end),
          (if has("workspaces") then "the workspace plan" else empty end) ] | join(" and ")' <<<"$change")"
    fi
    # Moving a display that is on the network can move it beside or apart,
    # which decides whether its viewers may take input: start it again.
    while IFS= read -r vname; do
      [[ -n $vname ]] || continue
      if unit_active "$(virtual_unit "$vname" network)"; then
        ( virtual_view_network "$vname" on "" "" "" ) || echo "omarchy-candela: $vname could not be offered on the network again" >&2
      fi
    done < <(jq -r --arg vre "$VIRTUAL_RE" '[.displays // [] | .[] | select(.position != null) | .name | select(test($vre))] | unique | .[]' <<<"$change")
    return 0
  fi

  notify_shell
  echo "pending $expires"
}

cmd_keep() {
  [[ -s $PENDING_FILE ]] || { echo "nothing pending"; return 0; }
  local intent previous baseline targets files err restore_err
  intent="$(jq -c '.intent' "$PENDING_FILE")"
  previous="$(jq -c '.previousIntent' "$PENDING_FILE")"
  baseline="$(jq -c '.baseline' "$PENDING_FILE")"
  targets="$(jq -c '.targets//[]' "$PENDING_FILE")"
  files="$(jq -c '.files' "$PENDING_FILE")"
  jq '.phase="saving"' "$PENDING_FILE" > "$PENDING_FILE.tmp" && mv "$PENDING_FILE.tmp" "$PENDING_FILE"
  # Keep this call in the current shell: commit_intent returns the load probe
  # through LAST_PROBE, and a command substitution would lose that assignment.
  if commit_intent "$intent"; then
    rm -f "$PENDING_LUA"
    err="$(reload_and_check "$(intent_json)" "$LAST_PROBE" "$targets")" || true
  else
    err="persistence failed"
  fi
  if [[ -n $err ]]; then
    local ws_before
    ws_before="$(jq -c '.workspacesBefore // null' "$PENDING_FILE")"
    if ! restore_files "$files"; then
      jq --arg e "$err; restoring the saved files failed" '.phase="failed"|.recovery={available:true,error:$e,restored:false}' "$PENDING_FILE" > "$PENDING_FILE.tmp" && mv "$PENDING_FILE.tmp" "$PENDING_FILE"
      die "keep failed and recovery record was retained: $err; restoring the saved files failed"
    fi
    if restore_err="$(restore_observed "$baseline")"; then
      restore_workspaces "$ws_before"
      jq --arg e "$err" '.phase="failed"|.recovery={available:true,error:$e,restored:true}' "$PENDING_FILE" > "$PENDING_FILE.tmp" && mv "$PENDING_FILE.tmp" "$PENDING_FILE"
      die "keep failed; previous configuration restored: $err"
    fi
    jq --arg e "$err; recovery failed: $restore_err" '.phase="failed"|.recovery={available:true,error:$e,restored:false}' "$PENDING_FILE" > "$PENDING_FILE.tmp" && mv "$PENDING_FILE.tmp" "$PENDING_FILE"
    die "keep failed and recovery remains available: $err; $restore_err"
  fi
  stop_timer
  rm -f "$PENDING_FILE" "$PENDING_LUA"
  echo "kept"
}

cmd_revert() {
  local expired=0 token=""
  while (( $# > 0 )); do
    case "$1" in
      --expired) expired=1; shift ;;
      --token) token="${2:-}"; shift 2 ;;
      *) die "revert: unknown option $1" ;;
    esac
  done

  # Nothing pending, but a workspace change was kept at once: undo that.
  if (( ! expired )) && [[ ! -s $PENDING_FILE ]] && fresh_undo; then
    undo_last
    return
  fi

  if (( expired )); then
    # The setsid fallback timer (start_timer) cannot be cancelled, so a
    # stale one must never revert a change that was since kept or replaced
    # by a newer apply: only act when pending.json still names this token.
    if [[ ! -s $PENDING_FILE ]] || [[ "$(jq -r '.token // empty' "$PENDING_FILE")" != "$token" ]]; then
      echo "nothing to revert"
      return 0
    fi
  fi

  # When the timer itself runs this, stopping the transient service would
  # SIGTERM this very process before the pending file is removed. The timer
  # has already elapsed, so only an interactive revert needs to cancel it.
  (( expired )) || stop_timer
  local had_pending=0 baseline=null files='{}' files_err="" live_err="" err phase_before=previewing ws_before=null
  if [[ -s $PENDING_FILE ]]; then had_pending=1; baseline="$(jq -c '.baseline//null' "$PENDING_FILE")"; files="$(jq -c '.files//{}' "$PENDING_FILE")"; phase_before="$(jq -r '.phase // "previewing"' "$PENDING_FILE")"; ws_before="$(jq -c '.workspacesBefore//null' "$PENDING_FILE")"; fi
  [[ -s $PENDING_FILE ]] && jq '.phase="reverting"' "$PENDING_FILE" > "$PENDING_FILE.tmp" && mv "$PENDING_FILE.tmp" "$PENDING_FILE"
  restore_files "$files" || files_err="restoring the saved files failed"
  if (( had_pending )); then
    if [[ $baseline == null ]]; then
      # A journal written before baselines existed: the reload alone is the
      # revert, as it always was. Replaying the pre-reload live state here
      # would put the preview straight back.
      run_apply_bounded hyprctl reload >/dev/null 2>&1 || live_err="Hyprland reload failed"
    elif ! live_err="$(restore_observed "$baseline")"; then
      live_err="${live_err:-reload or baseline replay failed}"
    fi
    # A reload leaves open workspaces where the preview moved them.
    restore_workspaces "$ws_before"
  fi
  if [[ -n $files_err || -n $live_err ]]; then
    err="${files_err}${files_err:+${live_err:+; }}${live_err}"
    jq --arg e "$err" '.phase="failed"|.recovery={available:true,error:$e,restored:false}' "$PENDING_FILE" > "$PENDING_FILE.tmp" && mv "$PENDING_FILE.tmp" "$PENDING_FILE"
    die "revert failed; recovery record retained: $err"
  fi
  rm -f "$PENDING_FILE"
  if (( expired && had_pending )); then
    if [[ $phase_before == failed ]]; then
      omarchy-notification-send "Display changes reverted" "Saving them had failed; the previous configuration is back." -t 4000 2>/dev/null || true
    else
      omarchy-notification-send "Display changes reverted" "They were not kept within ${REVERT_SECONDS} seconds." -t 4000 2>/dev/null || true
    fi
  fi
  notify_shell
  echo "reverted"
}

write_undo() {
  local previous="$1" placement="$2" what="${3:-the last change}" tmp
  mkdir -p "$STATE_DIR"
  tmp="$(tmp_for "$UNDO_FILE")"
  jq -n --argjson previous "$previous" --argjson placement "$placement" --argjson since "$(now_epoch)" --arg what "$what" \
    '{since:$since, what:$what, previousIntent:$previous, placement:$placement}' > "$tmp" && mv "$tmp" "$UNDO_FILE"
}

# The undo record, or nothing once it is older than UNDO_SECONDS (then it is
# deleted, so nothing can reach it later).
fresh_undo() {
  [[ -s $UNDO_FILE ]] || return 1
  local since
  since="$(jq -r '.since // 0' "$UNDO_FILE" 2>/dev/null || echo 0)"
  if (( $(now_epoch) - since > UNDO_SECONDS )); then rm -f "$UNDO_FILE"; return 1; fi
}

# Undo the last change that was kept at once: put the intent back exactly as
# it was, remove or recreate virtual displays to match (servers stopped before
# an output goes), and put the open workspaces back where they were.
undo_last() {
  local undo previous live name err
  undo="$(cat "$UNDO_FILE")"
  rm -f "$UNDO_FILE"
  previous="$(jq -c '.previousIntent' <<<"$undo")"
  live="$(live_json)"
  while IFS= read -r name; do
    [[ -n $name ]] && virtual_destroy "$name"
  done < <(jq -r -n --argjson p "$previous" --argjson live "$live" --arg vre "$VIRTUAL_RE" \
             '[$live[].name | select(test($vre))] - [($p.virtual // {}) | keys[]] | .[]')
  commit_intent "$previous" || die "could not write the previous configuration back"
  err="$(reload_and_check "$(intent_json)" "$LAST_PROBE")" || die "undo did not load: $err"
  while IFS= read -r name; do
    [[ -n $name ]] && virtual_create "$name"
  done < <(jq -r -n --argjson p "$previous" --argjson live "$(live_json)" \
             '[($p.virtual // {}) | keys[]] - [$live[].name] | .[]')
  restore_workspaces "$(jq -c '.placement // []' <<<"$undo")"
  notify_shell
  echo "reverted"
}

cmd_workspaces() {
  local action="${1:-}" intent err
  [[ $action == home ]] || die "workspaces supports only: home"
  if [[ -s $PENDING_FILE ]]; then intent="$(jq -c '.intent' "$PENDING_FILE")"; else intent="$(intent_json)"; fi
  if [[ $(jq -r '(.workspaces.homes // {}) | length' <<<"$intent") == 0 ]]; then echo "no workspace plan"; return 0; fi
  err="$(move_workspaces_home "$intent")" || die "$err"
  notify_shell
  echo "home"
}

# ---------------------------------------------------------------- virtual displays
#
# A virtual display is a Hyprland headless output named VIRTUAL-n that this
# tool creates and owns. It is seen in two ways. "window" is the shell's own
# live picture of it (Quickshell's screen capture, in a Candela window): no
# VNC, nothing on any socket, and nothing to install. "network" is wayvnc on
# one LAN address behind a username, a generated password and an RSA key
# (RSA-AES), for a tablet or another computer; wayvnc is the one package this
# needs, and `virtual install` offers Omarchy's installer for it.
#
# Hyprland has one cursor, and a VNC viewer's input moves it. A display
# placed apart is past a gap the pointer cannot cross, so input from a viewer
# could leave the cursor on a screen nobody can see, out of the mouse's
# reach. Network viewing of a display placed apart is therefore view-only
# (wayvnc -d); a display beside the desk takes input.
#
# wayvnc never reads ~/.config/wayvnc/config here: it gets a config of its
# own. And wayvnc carries on serving the previous output, a real display,
# when its own goes away, so every path that removes a virtual display stops
# its server first.

is_virtual() { [[ $1 =~ $VIRTUAL_RE ]]; }
virtual_run_dir() { printf '%s/omarchy-candela' "${XDG_RUNTIME_DIR:-/run/user/$UID}"; }
virtual_unit() { printf 'omarchy-candela-%s-%s' "$2" "$1"; }   # NAME kind: network

need_wayvnc() {
  command -v "$WAYVNC" >/dev/null 2>&1 || die "wayvnc is not installed: install the wayvnc package to see virtual displays"
}

# Run a command as a transient user unit, replacing one of the same name;
# without a user manager, detach it instead.
spawn_unit() {
  local unit="$1"; shift
  run_bounded systemctl --user stop "$unit.service" >/dev/null 2>&1 || true
  if run_bounded systemd-run --user --quiet --collect --unit="$unit" -- "$@" >/dev/null 2>&1; then return 0; fi
  (setsid bash -c 'exec 9>&-; exec "$@"' _ "$@" >/dev/null 2>&1 &)
}

unit_active() { run_bounded systemctl --user is-active --quiet "$1.service" >/dev/null 2>&1; }

wait_for_socket() {
  local path="$1" deadline
  deadline=$(( $(now_ms) + $(awk -v s="$VNC_WAIT_SECONDS" 'BEGIN { printf "%d", s * 1000 }') ))
  while (( $(now_ms) < deadline )); do
    [[ -S $path ]] && return 0
    sleep 0.1
  done
  [[ -S $path ]] || (( VNC_WAIT_SECONDS == 0 ))
}

virtual_stop() {
  local name="$1" kind="$2" ctl
  ctl="$(virtual_run_dir)/$name-$kind.ctl"
  if [[ -S $ctl ]] && command -v wayvncctl >/dev/null 2>&1; then
    run_bounded wayvncctl -S "$ctl" wayvnc-exit >/dev/null 2>&1 || true
  fi
  run_bounded systemctl --user stop "$(virtual_unit "$name" "$kind").service" >/dev/null 2>&1 || true
  rm -f -- "$ctl"
}

virtual_stop_all() {
  virtual_stop "$1" network
  run_bounded omarchy-shell -q "$PLUGIN_ID" preview "$1" off >/dev/null 2>&1 || true
}

# Beside: sharing an edge with a real display that is on, so the pointer can
# always come back from it.
virtual_is_beside() {
  live_json | jq -e --arg n "$1" --arg vre "$VIRTUAL_RE" '
    def lw: (if ((.transform // 0) % 2) == 1 then .height else .width end) / .scale;
    def lh: (if ((.transform // 0) % 2) == 1 then .width else .height end) / .scale;
    def box: {x, y, w: (lw | round), h: (lh | round)};
    ([.[] | select(.name == $n)][0] // null) as $v
    | if $v == null then false else
        ($v | box) as $a
        | [ .[] | select(.disabled != true and .width > 0 and ((.mirrorOf // "none") == "none") and (.name | test($vre) | not)) | box ]
        | any(. as $b
            | ((($a.x + $a.w == $b.x) or ($b.x + $b.w == $a.x)) and $a.y < $b.y + $b.h and $b.y < $a.y + $a.h)
              or ((($a.y + $a.h == $b.y) or ($b.y + $b.h == $a.y)) and $a.x < $b.x + $b.w and $b.x < $a.x + $a.w))
      end' >/dev/null 2>&1
}

# Rules for it are already loaded (the layout file carries them); this only
# asks Hyprland for the output and checks where it landed.
virtual_create() {
  local name="$1" out err
  out="$(run_apply_bounded hyprctl output create headless "$name" 2>&1)" || { printf 'hyprctl output create failed: %s' "$out" >&2; return 1; }
  [[ $out == ok* ]] || { printf 'Hyprland did not create %s: %s\n' "$name" "$out" >&2; return 1; }
  if ! err="$(verify_live "$(intent_json)" "$(jq -nc --arg n "$name" '[$n]')")"; then
    printf '%s did not land where asked: %s\n' "$name" "$err" >&2; return 1
  fi
}

virtual_destroy() {
  local name="$1"
  virtual_stop_all "$name"
  if live_json | jq -e --arg n "$name" 'any(.name == $n)' >/dev/null; then
    run_apply_bounded hyprctl output remove "$name" >/dev/null 2>&1 || true
  fi
}

# LAN addresses a network viewer can be offered on: IPv4, interfaces that are
# up, not loopback and not a local bridge for containers or VMs. TSV:
# address, interface.
virtual_lan_addresses() {
  ip -4 -o addr show up 2>/dev/null | awk '
    function net(ip, bits,   o, n, i, m, out) {
      split(ip, o, "."); n = o[1] * 16777216 + o[2] * 65536 + o[3] * 256 + o[4]
      m = 2 ^ 32 - 2 ^ (32 - bits); n = n - n % (2 ^ (32 - bits))
      out = int(n / 16777216) "." int(n / 65536) % 256 "." int(n / 256) % 256 "." n % 256
      return out "/" bits
    }
    { split($4, a, "/"); print a[1] "\t" $2 "\t" net(a[1], a[2]) }' \
    | grep -vE $'\t(lo|virbr[0-9]*|docker[0-9]*|br-[0-9a-f]+|veth[0-9a-z]*)\t' || true
}

# Does the firewall let a client reach this port? Omarchy turns ufw on with
# incoming connections dropped, so a tablet's connection goes nowhere until
# the port is allowed. "open", "blocked", or "unknown" (rules not readable).
virtual_firewall() {
  local port="$1" rules="$UFW_DIR/ufw/user.rules"
  # ufw is a system service, not one of the user's.
  run_bounded systemctl is-active --quiet ufw.service >/dev/null 2>&1 || { echo open; return; }
  grep -q '^DEFAULT_INPUT_POLICY="ACCEPT"' "$UFW_DIR/default/ufw" 2>/dev/null && { echo open; return; }
  [[ -r $rules ]] || { echo unknown; return; }
  awk -v port="$port" '
    /^### tuple ### allow / {
      proto = $5; dport = $6; dir = $NF
      if (dir ~ /^comment=/) dir = $(NF - 1)
      if (dir != "in" || (proto != "tcp" && proto != "any")) next
      if (dport == "any" || dport == port) { found = 1; exit }
      n = split(dport, list, ",")
      for (i = 1; i <= n; i++) {
        if (list[i] == port) { found = 1; exit }
        if (split(list[i], r, ":") == 2 && port + 0 >= r[1] + 0 && port + 0 <= r[2] + 0) { found = 1; exit }
      }
    }
    END { print (found ? "open" : "blocked") }' "$rules"
}

# The username, password and RSA key a network viewer is offered, made once
# and kept (0600, in a 0700 directory), so a client that accepted the key's
# fingerprint keeps recognising it.
virtual_secret_dir() {
  local dir="$VIRTUAL_DIR/$1"
  mkdir -p "$dir" && chmod 700 "$VIRTUAL_DIR" "$dir"
  if [[ ! -s $dir/rsa_key.pem ]]; then
    command -v ssh-keygen >/dev/null 2>&1 || die "ssh-keygen (openssh) is needed to make the network key"
    ssh-keygen -q -m pem -t rsa -b 3072 -N "" -C "candela $1" -f "$dir/rsa_key.pem" >/dev/null 2>&1 || die "could not make the network key"
    rm -f -- "$dir/rsa_key.pem.pub"
  fi
  [[ -s $dir/secret ]] || virtual_new_secret "$dir"
  chmod 600 "$dir/rsa_key.pem" "$dir/secret"
  printf '%s' "$dir"
}

# neatvnc allows 30 seconds for the whole login (HANDSHAKE_TIMEOUT, not
# configurable), and a tablet asks for the password inside it. So the
# password is easy to type: four groups of four from lowercase letters and
# digits without look-alikes (no 0 o 1 l i), no shift key, about 79 bits.
virtual_new_secret() {
  local dir="$1" alphabet=abcdefghjkmnpqrstuvwxyz23456789 raw out="" i
  raw="$(od -An -tu1 -N64 /dev/urandom | tr -s ' ' '\n' | grep -v '^$')"
  i=0
  while IFS= read -r b; do
    (( b >= 248 )) && continue            # 248 = 8 * 31: keep the choice uniform
    out+="${alphabet:$(( b % 31 )):1}"
    i=$(( i + 1 ))
    (( i % 4 == 0 && i < 16 )) && out+="-"
    (( i == 16 )) && break
  done <<<"$raw"
  (( i == 16 )) || die "could not make a password"
  ( umask 077; printf '%s\n' "$out" > "$dir/secret" )
}

virtual_network_settings() {
  local f="$VIRTUAL_DIR/$1/network.json"
  if [[ -s $f ]]; then cat "$f"; else echo '{}'; fi
}

# The window view belongs to the shell; this asks it.
virtual_view_window() {
  run_bounded omarchy-shell "$PLUGIN_ID" preview "$1" "$2" >/dev/null 2>&1 \
    || die "the Candela plugin is not running, and the window view is drawn by it"
}

virtual_view_network() {
  local name="$1" mode="$2" address="$3" port="$4" at_login="$5" saved dir conf ctl n tmp pw
  saved="$(virtual_network_settings "$name")"
  if [[ $mode == off ]]; then
    virtual_stop "$name" network
    if [[ -n $at_login ]]; then
      mkdir -p "$VIRTUAL_DIR/$name"
      jq --argjson a "$([[ $at_login == yes ]] && echo true || echo false)" '.atLogin = $a' <<<"$saved" > "$VIRTUAL_DIR/$name/network.json"
    fi
    return 0
  fi
  need_wayvnc
  # Never a display that is off: wayvnc would serve a real one instead.
  live_json | jq -e --arg n "$name" 'any(.[]; .name == $n and .disabled != true)' >/dev/null \
    || die "$name is off: switch it on before offering it on the network"
  [[ -n $address ]] || address="$(jq -r '.address // ""' <<<"$saved")"
  [[ -n $address ]] || address="$(virtual_lan_addresses | head -1 | cut -f1)"
  [[ -n $address ]] || die "no LAN address to offer $name on"
  # One address of this machine, never every interface at once.
  virtual_lan_addresses | cut -f1 | grep -qxF "$address" || die "$address is not a LAN address of this machine: choose one of $(virtual_lan_addresses | cut -f1 | paste -sd' ')"
  n="${name#VIRTUAL-}"
  [[ -n $port ]] || port="$(jq -r --arg d "$(( 5900 + n ))" '.port // ($d | tonumber)' <<<"$saved")"
  [[ $port =~ ^[0-9]+$ ]] && (( port >= 1024 && port <= 65535 )) || die "port must be 1024 to 65535"
  [[ -n $at_login ]] || at_login="$(jq -r 'if .atLogin == true then "yes" else "no" end' <<<"$saved")"
  dir="$(virtual_secret_dir "$name")"
  pw="$(cat "$dir/secret")"
  conf="$dir/network.conf"
  local before=""
  [[ -f $conf ]] && before="$(cat "$conf"; jq -r '.input' "$dir/network.json" 2>/dev/null)"
  ( umask 077
    # RSA-AES with a username and password. Never relax_encryption (it lets
    # unencrypted Apple DH and DES in) and never a WebSocket listener: both
    # also crash the neatvnc Arch ships.
    printf 'enable_auth=true\nusername=candela\npassword=%s\nrsa_private_key_file=%s\naddress=%s\nport=%s\n' \
      "$pw" "$dir/rsa_key.pem" "$address" "$port" > "$conf" )
  ctl="$(virtual_run_dir)/$name-network.ctl"
  mkdir -p "$(virtual_run_dir)" && chmod 700 "$(virtual_run_dir)"
  # -R: never let a client resize the output (with it, wayvnc resizes any
  # output to the client's window and moves it to 0,0). -d: watch-only when
  # placed apart, so a viewer can never leave the cursor out of reach.
  local -a input=()
  virtual_is_beside "$name" || input=(-d)
  # Restarting drops whoever is connected: only when something changed.
  if [[ -n $before && $before == "$(cat "$conf"; (( ${#input[@]} )) && echo false || echo true)" ]] \
     && unit_active "$(virtual_unit "$name" network)"; then
    tmp="$(tmp_for "$dir/network.json")"
    jq --argjson l "$([[ $at_login == yes ]] && echo true || echo false)" '.atLogin = $l' "$dir/network.json" > "$tmp" && mv "$tmp" "$dir/network.json"
    return 0
  fi
  spawn_unit "$(virtual_unit "$name" network)" "$WAYVNC" -C "$conf" -o "$name" -S "$ctl" -R "${input[@]}"
  wait_for_socket "$ctl" || die "wayvnc did not start for $name: journalctl --user -u $(virtual_unit "$name" network)"
  tmp="$(tmp_for "$dir/network.json")"
  jq -n --arg a "$address" --argjson p "$port" --argjson l "$([[ $at_login == yes ]] && echo true || echo false)" \
    --argjson i "$( (( ${#input[@]} )) && echo false || echo true)" \
    '{address:$a, port:$p, atLogin:$l, input:$i}' > "$tmp" && mv "$tmp" "$dir/network.json"
}

# Where a new virtual display goes, in logical px. Beside: flush against a
# real display, trying right of the rightmost, then below it, then left of
# the leftmost, and taking the first place nothing else occupies. Apart: past
# the right edge of everything, with a gap the pointer cannot cross.
virtual_position() {
  local live="$1" beside="$2" width="$3" height="$4"
  jq -r -n --argjson live "$live" --arg beside "$beside" --arg vre "$VIRTUAL_RE" --argjson gap "$VIRTUAL_GAP" \
        --argjson w "$width" --argjson h "$height" '
    def lw: (if ((.transform // 0) % 2) == 1 then .height else .width end) / .scale | round;
    def lh: (if ((.transform // 0) % 2) == 1 then .width else .height end) / .scale | round;
    [ $live[] | select(.disabled != true and .width > 0) | {name, x, y, w: lw, h: lh, virtual: (.name | test($vre))} ] as $on
    | [ $on[] | select(.virtual | not) ] as $real
    | ($on | map(.x + .w) | max // 0) as $right
    | def free($c): all($on[]; ($c.x + $w <= .x or .x + .w <= $c.x or $c.y + $h <= .y or .y + .h <= $c.y));
      if $beside == "" then "\($right + $gap)x0"
      else
        (if $beside == "auto" then ($real | max_by(.x + .w)) else ([$real[] | select(.name == $beside)][0]) end) as $d
        | if $d == null then error("no such display: " + $beside) else
            ($real | min_by(.x)) as $l
            | [ {x: ($d.x + $d.w), y: $d.y}, {x: $d.x, y: ($d.y + $d.h)}, {x: ($l.x - $w), y: $l.y} ]
            | (map(select(free(.))) | first) // .[0]
            | "\(.x)x\(.y)"
          end
      end'
}

cmd_virtual() {
  local action="${1:-}"; shift || true
  case "$action" in
    add) cmd_virtual_add "$@" ;;
    remove) cmd_virtual_remove "$@" ;;
    view)
      local name="${1:-}" kind="${2:-}" mode="${3:-}" address="" port="" at_login=""
      shift 3 || die "virtual view needs NAME window|network on|off"
      is_virtual "$name" && intent_json | jq -e --arg n "$name" '.virtual | has($n)' >/dev/null 2>&1 || die "no virtual display named $name"
      [[ $mode == on || $mode == off ]] || die "virtual view: on or off"
      while (( $# > 0 )); do
        case "$1" in
          --address) address="${2:-}"; shift 2 ;;
          --port) port="${2:-}"; shift 2 ;;
          --at-login) at_login="${2:-}"; [[ $at_login == yes || $at_login == no ]] || die "--at-login yes or no"; shift 2 ;;
          *) die "virtual view: unknown option $1" ;;
        esac
      done
      case "$kind" in
        window) virtual_view_window "$name" "$mode" ;;
        network) virtual_view_network "$name" "$mode" "$address" "$port" "$at_login" ;;
        *) die "virtual view: window or network" ;;
      esac
      notify_shell
      echo "$name $kind $mode"
      ;;
    secret)
      local name="${1:-}"
      is_virtual "$name" || die "no virtual display named $name"
      if [[ " $* " == *" --new "* ]]; then
        acquire_lock
        mkdir -p "$VIRTUAL_DIR/$name" && chmod 700 "$VIRTUAL_DIR" "$VIRTUAL_DIR/$name"
        virtual_new_secret "$VIRTUAL_DIR/$name"
        # A running server keeps the old password until it starts again.
        if unit_active "$(virtual_unit "$name" network)"; then
          virtual_stop "$name" network
          virtual_view_network "$name" on "" "" ""
        fi
      fi
      [[ -s $VIRTUAL_DIR/$name/secret ]] || die "$name has never been offered on the network"
      # --qr adds the password as a QR code (a base64 PNG) for a tablet's
      # camera to copy, since the login has to be done within 30 seconds.
      # qrencode is in Omarchy's base packages; without it there is no code.
      local qr=""
      if [[ " $* " == *" --qr "* ]] && command -v qrencode >/dev/null 2>&1; then
        # Without the file's newline, which a copied password would carry
        # into the login; through stdin, so it never shows in a process list.
        qr="$(printf '%s' "$(cat "$VIRTUAL_DIR/$name/secret")" | qrencode -t PNG -s 8 -m 2 -o - | base64 -w0)" || qr=""
      fi
      jq -nc --arg p "$(cat "$VIRTUAL_DIR/$name/secret")" --arg qr "$qr" \
        '{username:"candela", password:$p} + (if $qr == "" then {} else {qr:$qr} end)'
      ;;
    clients)
      local name="${1:-}" ctl
      ctl="$(virtual_run_dir)/$name-network.ctl"
      if command -v wayvncctl >/dev/null 2>&1 && unit_active "$(virtual_unit "$name" network)"; then
        run_bounded wayvncctl -S "$ctl" -j client-list 2>/dev/null || echo '[]'
      else
        echo '[]'
      fi
      ;;
    disconnect)
      local name="${1:-}" id="${2:-}"
      [[ $id =~ ^[0-9]+$ ]] || die "virtual disconnect NAME ID"
      run_bounded wayvncctl -S "$(virtual_run_dir)/$name-network.ctl" client-disconnect "$id" >/dev/null || die "could not disconnect client $id"
      echo "disconnected $id"
      ;;
    restore) cmd_virtual_restore ;;
    guard) cmd_virtual_guard ;;
    install)
      # The one package network viewing needs, through Omarchy's own
      # installer, in a terminal where its password prompt can be seen.
      command -v "$WAYVNC" >/dev/null 2>&1 && { echo "wayvnc is installed"; return 0; }
      command -v omarchy-launch-floating-terminal-with-presentation >/dev/null 2>&1 \
        || die "install the wayvnc package to offer virtual displays on the network"
      setsid omarchy-launch-floating-terminal-with-presentation omarchy pkg add wayvnc >/dev/null 2>&1 &
      echo "installing wayvnc in a terminal"
      ;;
    *) die "virtual supports: add, remove, view, secret, clients, disconnect, restore, guard, install" ;;
  esac
}

cmd_virtual_add() {
  local use="${1:-}"; shift || true
  local size refresh=60 scale beside="" apart=0 label
  case "$use" in
    extra) size=2732x2048; scale=2; label="Tablet" ;;
    stage) size=1920x1080; scale=1; apart=1; label="Stage" ;;
    bench) size=1366x768; scale=1; label="Bench" ;;
    *) die "virtual add needs what it is for: extra, stage or bench" ;;
  esac
  while (( $# > 0 )); do
    case "$1" in
      --size) size="${2:-}"; shift 2 ;;
      --refresh) refresh="${2:-}"; shift 2 ;;
      --scale) scale="${2:-}"; shift 2 ;;
      --beside) beside="${2:-}"; apart=0; shift 2 ;;
      --apart) apart=1; beside=""; shift ;;
      --label) label="${2:-}"; shift 2 ;;
      *) die "virtual add: unknown option $1" ;;
    esac
  done
  [[ $size =~ ^([0-9]{3,5})x([0-9]{3,5})$ ]] && (( BASH_REMATCH[1] >= 320 && BASH_REMATCH[1] <= 8192 && BASH_REMATCH[2] >= 240 && BASH_REMATCH[2] <= 8192 )) \
    || die "size must be WIDTHxHEIGHT, 320x240 to 8192x8192"
  [[ $refresh =~ ^[0-9]+$ ]] && (( refresh >= 1 && refresh <= 240 )) || die "refresh must be 1 to 240 Hz"
  awk -v s="$scale" 'BEGIN { exit !(s + 0 > 0 && s + 0 <= 10) }' || die "scale must be above 0 and at most 10"
  [[ $label =~ ^[[:alnum:][:space:]._-]{1,32}$ ]] || die "label: up to 32 letters, digits, spaces, dots, dashes or underscores"
  [[ ! -s $PENDING_FILE ]] || die "a change is waiting to be kept or reverted; finish that first"

  local live intent name n=1 width position merged err placement
  live="$(live_json)"
  intent="$(intent_json)"
  while jq -e -n --argjson live "$live" --argjson intent "$intent" --arg n "VIRTUAL-$n" \
          'any($live[]; .name == $n) or (($intent.virtual // {}) | has($n))' >/dev/null; do
    n=$(( n + 1 ))
  done
  name="VIRTUAL-$n"
  local lw lh
  lw="$(awk -v w="${size%x*}" -v s="$scale" 'BEGIN { printf "%d", w / s + 0.5 }')"
  lh="$(awk -v h="${size#*x}" -v s="$scale" 'BEGIN { printf "%d", h / s + 0.5 }')"
  if (( apart )); then position="$(virtual_position "$live" "" "$lw" "$lh")"
  else position="$(virtual_position "$live" "${beside:-auto}" "$lw" "$lh")" || die "no such display: $beside"
  fi
  merged="$(jq -c --arg n "$name" --arg use "$use" --arg label "$label" --arg mode "$size@$refresh" --arg pos "$position" --argjson scale "$scale" \
    '.virtual[$n] = {label:$label, use:$use} | .displays[$n] = {mode:$mode, position:$pos, scale:$scale, transform:0} | .version = 1' <<<"$intent")"
  placement="$(workspaces_json)"
  rm -f "$UNDO_FILE"
  commit_intent "$merged" || die "could not write the layout"
  if ! err="$(reload_and_check "$(intent_json)" "$LAST_PROBE")" || ! virtual_create "$name"; then
    virtual_destroy "$name"
    commit_intent "$intent" && reload_and_check "$(intent_json)" "$LAST_PROBE" >/dev/null || true
    die "could not add $name${err:+: $err}"
  fi
  write_undo "$intent" "$placement" "adding $name"
  notify_shell
  echo "$name"
}

cmd_virtual_remove() {
  local name="${1:-}" live intent merged err placement
  is_virtual "$name" || die "virtual remove needs the name of a virtual display, like VIRTUAL-1"
  [[ ! -s $PENDING_FILE ]] || die "a change is waiting to be kept or reverted; finish that first"
  live="$(live_json)"
  intent="$(intent_json)"
  jq -e --arg n "$name" '(.virtual // {}) | has($n)' <<<"$intent" >/dev/null \
    || jq -e --arg n "$name" 'any(.name == $n)' <<<"$live" >/dev/null || die "no virtual display named $name"
  placement="$(workspaces_json)"
  # Servers first: wayvnc would move on to a real display.
  virtual_destroy "$name"
  merged="$(jq -c --arg n "$name" '
    del(.virtual[$n], .displays[$n])
    | if (.virtual // {}) == {} then del(.virtual) else . end
    | if .workspaces then
        .workspaces.homes |= with_entries(select(.value != $n))
        | .workspaces.shows = ((.workspaces.shows // {}) | del(.[$n]))
        | if (.workspaces.homes | length) == 0 then del(.workspaces)
          elif (.workspaces.shows | length) == 0 then del(.workspaces.shows) else . end
      else . end' <<<"$intent")"
  rm -f "$UNDO_FILE"
  commit_intent "$merged" || die "could not write the layout"
  err="$(reload_and_check "$(intent_json)" "$LAST_PROBE")" || die "$name is gone, but the layout did not load: $err"
  rm -rf -- "${VIRTUAL_DIR:?}/$name"
  write_undo "$intent" "$placement" "removing $name"
  notify_shell
  echo "removed $name"
}

# At the start of every shell: create the kept virtual displays that are not
# there, and offer on the network the ones that were asked to be at login.
cmd_virtual_restore() {
  local live name made=0
  live="$(live_json)"
  while IFS= read -r name; do
    [[ -n $name ]] || continue
    if jq -e --arg n "$name" 'any(.name == $n)' <<<"$live" >/dev/null; then continue; fi
    virtual_create "$name" && made=$(( made + 1 ))
  done < <(intent_json | jq -r '(.virtual // {}) | keys[]')
  while IFS= read -r name; do
    [[ -n $name ]] || continue
    if [[ $(jq -r '.atLogin == true' "$VIRTUAL_DIR/$name/network.json" 2>/dev/null) == true ]] && ! unit_active "$(virtual_unit "$name" network)"; then
      ( virtual_view_network "$name" on "" "" yes ) || echo "omarchy-candela: $name was not offered on the network" >&2
    fi
  done < <(intent_json | jq -r '(.virtual // {}) | keys[]')
  (( made == 0 )) || notify_shell
  echo "restored $made"
}

# Hyprland parks an unplugged display's workspaces on the first other display
# in connect order, which can be a virtual one nobody is looking at. Move
# every workspace on a virtual display that does not live there (its own
# named workspace, or a home in the plan) to the leftmost real display.
cmd_virtual_guard() {
  local live intent open target moves id to line moved=0
  live="$(live_json)"
  intent="$(intent_json)"
  open="$(run_bounded hyprctl workspaces -j 2>/dev/null | jq -c '[.[] | select(.id > 0 or .id < -1337) | {id, name, monitor}]' 2>/dev/null || echo '[]')"
  target="$(jq -r --arg vre "$VIRTUAL_RE" '[.[] | select(.disabled != true and .width > 0 and ((.mirrorOf // "none") == "none") and (.name | test($vre) | not))] | sort_by(.x, .y) | .[0].name // ""' <<<"$live")"
  [[ -n $target ]] || { echo "no real display to move them to"; return 0; }
  moves="$(jq -r -n --argjson intent "$intent" --argjson open "$open" --arg vre "$VIRTUAL_RE" "$JQ_VIRTUAL_DEFS"'
    virtual_workspace_names($intent.virtual) as $own
    | ($intent.workspaces.homes // {}) as $homes
    | $open[] | select(.monitor | test($vre))
    | select(.name != ($own[.monitor] // "") and ($homes[(.id | tostring)] // "") != .monitor)
    | (if .id > 0 then (.id | tostring) else "name:" + .name end)')"
  while IFS= read -r id; do
    [[ -n $id ]] || continue
    if line="$(dispatch_move "$id" "$target")"; then moved=$(( moved + 1 )); else echo "omarchy-candela: $line" >&2; fi
  done <<<"$moves"
  echo "moved $moved"
}

virtual_state_json() {
  local live="$1" intent="$2" name out='{}' network clients net wayvnc=false
  command -v "$WAYVNC" >/dev/null 2>&1 && wayvnc=true
  while IFS= read -r name; do
    [[ -n $name ]] || continue
    network=false; clients='[]'
    if unit_active "$(virtual_unit "$name" network)"; then network=true; clients="$(cmd_virtual clients "$name")"; fi
    net="$(virtual_network_settings "$name")"
    local port fw lan
    port="$(jq -r --arg d "$(( 5900 + ${name#VIRTUAL-} ))" '.port // ($d | tonumber)' <<<"$net")"
    fw="$(virtual_firewall "$port")"
    lan="$(virtual_lan_addresses | awk -F'\t' -v a="$(jq -r '.address // ""' <<<"$net")" 'a == "" || $1 == a { print $3; exit }')"
    out="$(jq -c --arg n "$name" --argjson on "$network" --argjson c "$clients" --argjson net "$net" \
      --arg fw "$fw" --argjson port "$port" --arg lan "$lan" \
      '.[$n] = {network:($net + {on:$on, clients:$c, port:$port, firewall:$fw,
        firewallAllow:(if $lan == "" then null else "ufw allow from \($lan) to any port \($port) proto tcp" end)})}' <<<"$out")"
  done < <(jq -r '(.virtual // {}) | keys[]' <<<"$intent")
  jq -c -n --argjson intent "$intent" --argjson views "$out" --argjson wayvnc "$wayvnc" \
        --argjson addresses "$(virtual_lan_addresses | jq -R -s -c 'split("\n") | map(select(. != "") | split("\t") | {address:.[0], interface:.[1], network:.[2]})')" "$JQ_VIRTUAL_DEFS"'
    virtual_workspace_names($intent.virtual) as $ws
    | { wayvnc: $wayvnc, addresses: $addresses,
        displays: (($intent.virtual // {}) | with_entries(.value += {workspace: $ws[.key]} + ($views[.key] // {}))) }'
}

cmd_persist() {
  commit_intent "$(intent_json)"
  echo "$LUA_FILE"
}

cmd_hdr() {
  local mode="${1:-}"; shift || true
  [[ $mode =~ ^(on|off|wide)$ ]] || die "hdr needs on, off or wide"
  local display="" sdr_white="" now=()
  while (( $# > 0 )); do
    case "$1" in
      --display) display="${2:-}"; shift 2 ;;
      --sdr-white) sdr_white="${2:-}"; shift 2 ;;
      --now) now=(--now); shift ;;
      *) die "unknown option $1" ;;
    esac
  done
  [[ -n $display ]] || display="$(focused_name)"
  [[ -n $display ]] || die "no focused display"
  local caps change
  caps="$(edid_for "$display")"
  change="$(jq -nc --arg name "$display" --arg mode "$mode" --arg white "$sdr_white" --argjson caps "$caps" '
    def clamp($lo; $hi): if . < $lo then $lo elif . > $hi then $hi else . end;
    ($caps.hdr.maxFrameAverageLuminance // $caps.hdr.maxLuminance // 400) as $avg
    | (if $white != "" then ($white | tonumber) else 203 end | clamp(80; ([$avg, 80] | max)) | round) as $sdrWhite
    | { displays: [
        if $mode == "off" then { name: $name, bitdepth: 8, cm: "srgb", sdr_max_luminance: null, sdr_min_luminance: null }
        elif $mode == "wide" then { name: $name, bitdepth: 10, cm: "auto", sdr_max_luminance: null, sdr_min_luminance: null }
        else { name: $name, bitdepth: 10, cm: "hdr", sdr_max_luminance: $sdrWhite,
               sdr_min_luminance: (if ($caps.hdr.minLuminance // 0) > 0 then $caps.hdr.minLuminance else 0.2 end) }
        end ] }')"
  if [[ $mode == "on" ]] && ! jq -e '.supportsHdr == true' <<<"$caps" >/dev/null; then
    echo "omarchy-candela: $display does not advertise HDR (ST 2084) in its EDID; applying anyway" >&2
  fi
  cmd_apply "${now[@]}" "$change"
}

cmd_brightness() {
  local name="${1:-}"; shift || true
  [[ -n $name ]] || die "brightness needs a display name"
  omarchy-brightness-display --no-osd --monitor "$name" "$@"
}

cmd_identify() {
  omarchy-shell "$PLUGIN_ID" identify >/dev/null 2>&1 || die "the Candela plugin is not running"
}

cmd_open() {
  omarchy-shell shell summon "$PLUGIN_ID" '{}' >/dev/null 2>&1 || die "the Candela plugin is not running"
}

cmd_icc() {
  local action="${1:-list}"
  [[ $action == list && $# -le 1 ]] || die "icc supports only: list"
  local dirs=("$HOME/.local/share/icc" "$HOME/.color/icc" "$HOME/.local/share/color/icc" /usr/share/color/icc /usr/local/share/color/icc)
  {
    for d in "${dirs[@]}"; do
      [[ -d $d ]] || continue
      find "$d" -type f \( -iname '*.icc' -o -iname '*.icm' \) -print0 2>/dev/null
    done
  } | sort -zu | while IFS= read -r -d '' f; do [[ -r $f ]] && validate_icc "$f" && icc_record "$f" || true; done | jq -s .
}

icc_record() {
  local path="$1" statv hash
  statv="$(stat -c '%s %Y' "$path")"; hash="$(sha256sum "$path" | cut -d' ' -f1)"
  jq -nc --arg id "$hash" --arg name "$(basename "$path")" --arg path "$path" --argjson size "${statv%% *}" --argjson modified "${statv##* }" \
    '{id:$id,name:$name,path:$path,size:$size,modified:$modified}'
}

validate_icc() {
  local p="$1" declared actual sig
  actual="$(stat -c %s "$p")"; (( actual >= 128 )) || return 1
  declared="$(od -An -tu4 -N4 --endian=big "$p" | tr -d ' ')"; sig="$(dd if="$p" bs=1 skip=36 count=4 status=none)"
  [[ $sig == acsp && $declared =~ ^[0-9]+$ && $declared -ge 128 && $declared -le $actual ]]
}

# Everything a bug report needs and nothing it should not carry: versions,
# what each display is doing, what Candela kept, and doctor's verdict. Home
# paths become ~, and serial numbers and EDID hashes are never included, so
# the output can be pasted into a public issue as it stands. Reads only.
cmd_report() {
  local version hypr omarchy qs driver m state doctor_out errors toggles out
  version="$(jq -r '.version // "unknown"' "$SELF_DIR/../manifest.json" 2>/dev/null || echo unknown)"
  hypr="$(run_bounded hyprctl version 2>/dev/null | head -1 | awk '{print $2}')" || true
  omarchy="$(omarchy-version 2>/dev/null | head -1)" || true
  qs="$(quickshell --version 2>/dev/null | head -1 | awk '{print $2}')" || true
  driver=""
  if [[ -r /sys/module/nvidia/version ]]; then driver="nvidia $(cat /sys/module/nvidia/version)"; fi
  for m in amdgpu i915 xe nouveau; do [[ -d /sys/module/$m ]] && driver="${driver:+$driver, }$m"; done
  state="$(cmd_state 2>/dev/null)" || state='{"displays":[]}'
  doctor_out="$( (cmd_doctor) 2>&1 )" || true
  errors="$(run_bounded hyprctl configerrors 2>/dev/null | grep -v '^ok$' | grep -v '^[[:space:]]*$')" || true
  toggles="$(ls -1 "$TOGGLES_DIR" 2>/dev/null | paste -sd' ')" || true

  out="$({
    printf '## Candela report\n\n'
    printf -- '- Candela %s\n- Hyprland %s\n- Omarchy %s\n- Quickshell %s\n- Kernel %s\n- GPU driver %s\n\n' \
      "$version" "${hypr:-unknown}" "${omarchy:-unknown}" "${qs:-unknown}" "$(uname -r)" "${driver:-unknown}"
    printf '### Displays\n\n'
    jq -r '
      def v: if . == null then "?" elif . == true then "yes" elif . == false then "no" else tostring end;
      "| Output | Make and model | Mode | Scale | Position | Format | Colour | SDR white | HDR in EDID | Peak cd/m² |",
      "|---|---|---|---|---|---|---|---|---|---|",
      (.displays[] |
        "| \(.name) | \(((.make // "") + " " + (.model // "")) | gsub("^\\s+|\\s+$"; "")) | "
        + (if .enabled then "\(.width)x\(.height)@\(.refreshRate | . * 100 | round / 100)" else "off" end)
        + " | \(.scale | v) | \(.x)x\(.y) | \(.currentFormat | v) | \(.live.cm | v) | \(.live.sdrMaxLuminance | v)"
        + " | \(if .capabilities.available then (.capabilities.supportsHdr | v) else "no EDID" end)"
        + " | \(.capabilities.hdr.maxLuminance | v) |")
    ' <<<"$state"
    printf '\n### Pending change\n\n'
    jq -r 'if .pending == null then "None." else "Phase \(.pending.phase), \(.pending.remaining) s left" + (if .recovery then ", recovery: \(.recovery.error // "available")" else "" end) + "." end' <<<"$state"
    printf '\n### Kept configuration\n\n```json\n%s\n```\n' "$(intent_json | jq .)"
    printf '\n### doctor\n\n```\n%s\n```\n' "$doctor_out"
    printf '\n### Hyprland config errors\n\n%s\n' "${errors:-None.}"
    printf '\n### Toggles directory\n\n%s\n' "${toggles:-empty}"
  })"
  out="${out//"$HOME"/\~}"
  printf '%s\n' "$out"
}

cmd_recover() {
  local live rescue
  live="$(live_json)"
  # A virtual display on is still nothing anyone can see.
  live="$(jq -c --arg vre "$VIRTUAL_RE" 'map(select(.name | test($vre) | not))' <<<"$live")"
  if ! jq -e 'length > 0 and all(.disabled == true)' <<<"$live" >/dev/null; then
    echo "nothing to recover"
    return 0
  fi
  rescue="$(jq -r --arg re "$INTERNAL_RE" '([.[] | select(.name | test($re))][0] // .[0]).name' <<<"$live")"
  omarchy-notification-send "Candela" "Every display was off. Switching $rescue back on." -t 6000 2>/dev/null || true
  # A journal left from before the blackout would make the rescue's --now
  # join it as a preview with a timer, and the timer would switch the
  # display off again. The rescue outranks whatever that journal was for.
  if [[ -s $PENDING_FILE ]]; then stop_timer; rm -f "$PENDING_FILE" "$PENDING_LUA"; fi
  cmd_apply --now "$(jq -nc --arg n "$rescue" '{displays: [{name: $n, enabled: true}]}')" >/dev/null
  echo "recovered $rescue"
}

# Everything that has to hold for keep and revert to mean what they say,
# checked and said in one place. Exit 1 on anything that would break them.
cmd_doctor() {
  local status=0 live="" line
  ok() { echo "ok    $*"; }
  warn() { echo "warn  $*"; }
  bad() { echo "FAIL  $*"; status=1; }

  if live="$(hyprctl monitors all -j 2>/dev/null)"; then
    if jq -e 'any(.name == "FALLBACK")' <<<"$live" >/dev/null 2>&1; then
      warn "every display is off, and Hyprland is drawing to its invisible FALLBACK output: run \`omarchy-candela recover\`"
    fi
    live="$(jq -c 'map(select(.name != "FALLBACK"))' <<<"$live")"
    ok "hyprctl answers: $(jq 'length' <<<"$live") displays, $(hyprctl version 2>/dev/null | head -1 | cut -d' ' -f1-2)"
  else
    bad "hyprctl is not answering"
    live="[]"
  fi

  local hypr_lua="$HOME/.config/hypr/hyprland.lua"
  if [[ -f $hypr_lua ]]; then
    if grep -qE '^[[:space:]]*require\("default\.hypr\.toggles"\)' "$hypr_lua"; then
      ok "hyprland.lua loads the toggles directory, where the kept layout lives"
    else
      bad "$hypr_lua does not require(\"default.hypr.toggles\"): the kept layout is never read, and revert cannot restore it"
    fi
  else
    warn "$hypr_lua not found; this tool expects Omarchy's Lua config"
  fi

  if [[ -f $LUA_FILE ]]; then
    local probe
    probe="$(sed -nE 's/^omarchy_candela_layout_probe = "([^"]+)"$/\1/p' "$LUA_FILE" | head -1)"
    if [[ -z $probe ]]; then
      warn "$LUA_FILE predates the load probe: run \`omarchy-candela persist\`, then \`hyprctl reload\`"
    elif probe_loaded "$probe"; then
      ok "Hyprland ran $LUA_FILE on its last reload"
    else
      bad "Hyprland did not run $LUA_FILE on its last reload"
    fi
  else
    ok "nothing kept yet: your monitors.lua is in charge"
  fi

  if [[ -f $LUA_FILE ]]; then
    local away
    away="$(jq -r -n --arg file "$(cat "$LUA_FILE")" --argjson live "$live" '
      [ $file | split("\n")[] | capture("^hl\\.monitor\\(\\{ output = \"(?<n>[^\"]+)\"")? | .n
        | select(. as $n | [$live[].name] | index($n) == null) ] | unique | join(", ")')"
    [[ -z $away ]] || ok "kept rules wait for displays not connected now: $away"
  fi

  local plan
  plan="$(intent_json | jq -c '.workspaces.homes // {}')"
  if [[ $plan != "{}" ]]; then
    local mismatch absent
    if mismatch="$(verify_workspace_rules "$(intent_json)")"; then
      ok "workspace plan: $(jq 'length' <<<"$plan") homes, and Hyprland's rules match it"
    else
      bad "workspace plan: $mismatch. A rule of your own for the same workspace, written differently, can do this"
    fi
    absent="$(jq -r -n --argjson plan "$plan" --argjson live "$live" '[ $plan | to_entries[] | select(.value as $n | [$live[].name] | index($n) == null) | .value ] | unique | join(", ")')"
    [[ -z $absent ]] || ok "homes on $absent, not connected now: those workspaces open on another display until it is back"
  fi

  local vname conf
  while IFS= read -r vname; do
    [[ -n $vname ]] || continue
    if jq -e --arg n "$vname" 'any(.name == $n)' <<<"$live" >/dev/null; then
      ok "$vname is a virtual display: Candela's window shows it here$(virtual_is_beside "$vname" && echo ", and it sits beside your displays" || echo ", and it sits apart, out of the pointer's reach")"
    else
      warn "$vname is kept but not created: run \`omarchy-candela virtual restore\`"
    fi
    conf="$VIRTUAL_DIR/$vname/network.conf"
    if unit_active "$(virtual_unit "$vname" network)"; then
      local vport vfw
      vport="$(sed -n 's/^port=//p' "$conf" 2>/dev/null)"
      vfw="$(virtual_firewall "${vport:-0}")"
      if [[ $vfw == blocked ]]; then
        warn "the firewall (ufw) drops connections to port $vport, so no tablet can reach $vname. Allow your network, as root: ufw allow from $(virtual_lan_addresses | awk -F'\t' -v a="$(sed -n 's/^address=//p' "$conf")" '$1 == a { print $3; exit }') to any port $vport proto tcp"
      fi
      if [[ -f $conf ]] && grep -qx 'enable_auth=true' "$conf" && ! grep -qE '^(relax_encryption|allow_broken_crypto)=true' "$conf"; then
        ok "$vname is offered on $(sed -n 's/^address=//p' "$conf"):$(sed -n 's/^port=//p' "$conf") with a password and RSA-AES$(jq -e '.input == false' "$VIRTUAL_DIR/$vname/network.json" >/dev/null 2>&1 && echo ", watch-only")"
      else
        bad "$vname is on the network without the password and encryption this tool sets: \`omarchy-candela virtual view $vname network off\`"
      fi
    fi
  done < <(intent_json | jq -r '(.virtual // {}) | keys[]')
  if (( $(intent_json | jq '(.virtual // {}) | length') > 0 )) && ! command -v "$WAYVNC" >/dev/null 2>&1; then
    ok "wayvnc is not installed: virtual displays show in Candela's window, and \`omarchy-candela virtual install\` adds network viewing"
  fi

  local errors
  errors="$(hyprctl configerrors 2>/dev/null | grep -v '^ok$' || true)"
  if [[ -z $errors ]]; then ok "no Hyprland config errors"; else bad "Hyprland config errors: $errors"; fi

  if [[ -s $PENDING_FILE ]]; then
    local expires
    expires="$(jq -r '.expires // 0' "$PENDING_FILE")"
    if (( expires < $(now_epoch) )); then
      warn "a pending change expired without reverting: run \`omarchy-candela revert\`"
    else
      ok "a change is pending, $(( expires - $(now_epoch) )) s left"
    fi
  fi
  if [[ -f $PENDING_LUA && ! -s $PENDING_FILE ]]; then
    bad "$PENDING_LUA exists with nothing pending; delete it and \`hyprctl reload\`"
  fi

  for d in "$STATE_DIR" "$TOGGLES_DIR"; do
    mkdir -p "$d" 2>/dev/null && [[ -w $d ]] && ok "$d is writable" || bad "$d is not writable"
  done

  local tool
  for tool in edid-decode jq socat; do
    command -v "$tool" >/dev/null 2>&1 && ok "$tool found" || bad "$tool not found"
  done
  command -v ddcutil >/dev/null 2>&1 || command -v brightnessctl >/dev/null 2>&1 && ok "brightness tools found" || warn "neither ddcutil nor brightnessctl found: no brightness control"
  if command -v systemd-run >/dev/null 2>&1 && systemctl --user is-system-running >/dev/null 2>&1; then
    ok "systemd user manager runs the revert timer"
  else
    warn "no systemd user manager: the revert timer falls back to a detached shell"
  fi

  local internal monitors_lua="$HOME/.config/hypr/monitors.lua"
  internal="$(jq -r --arg re "$INTERNAL_RE" '[.[] | select(.name | test($re))][0].name // ""' <<<"$live")"
  if pgrep -f omarchy-hyprland-monitor-watch >/dev/null 2>&1; then
    if [[ -n $internal ]]; then
      local configured
      configured="$(sed -nE 's/^[[:space:]]*local[[:space:]]+omarchy_monitor_scale[[:space:]]*=[[:space:]]*([^[:space:]]+).*/\1/p' "$monitors_lua" 2>/dev/null | head -1)"
      if [[ $configured =~ ^[0-9]+([.][0-9]+)?$ ]]; then
        warn "monitors.lua sets omarchy_monitor_scale = $configured; Omarchy's clamshell script re-applies that scale to $internal with position auto on lid and monitor events, over the kept layout. Set it to \"auto\" there and choose the scale here."
      else
        ok "Omarchy's monitor watcher is running; with scale = \"auto\" in monitors.lua it leaves the kept layout alone"
      fi
      [[ -f $INTERNAL_FLAG ]] && ok "$internal is off through Omarchy's internal-monitor-disable toggle" || true
    else
      ok "Omarchy's monitor watcher is running; no built-in panel, nothing for it to reconcile"
    fi
  fi

  if [[ -f $monitors_lua ]]; then
    while IFS= read -r line; do
      [[ -n $line ]] || continue
      if grep -qE "^[^-]*hl\.monitor\(\{[^}]*output[[:space:]]*=[[:space:]]*\"$line\"" "$monitors_lua"; then
        warn "monitors.lua has its own rule for $line; the kept layout loads later and wins"
      fi
    done < <(intent_json | jq -r '.displays | keys[]')
  fi

  local dupes
  dupes="$(jq -r 'group_by(.make + "|" + .model + "|" + (.serial | gsub("^\\s+|\\s+$"; ""))) | map(select(length > 1) | map(.name) | join(" and ")) | .[]' <<<"$live")"
  while IFS= read -r line; do
    [[ -n $line ]] || continue
    ok "$line report the same make, model and serial; rules key them by connector, and their EDID hashes tell them apart"
  done <<<"$dupes"

  # exit, not return: a non-zero return would trip the ERR trap's "aborted"
  # line, and this exit is the verdict, not an accident.
  (( status == 0 )) || exit 1
}

cmd="${1:-}"; shift || true
case "$cmd" in
  state) cmd_state ;;
  apply) acquire_lock; cmd_apply "$@" ;;
  keep) acquire_lock; cmd_keep ;;
  revert) if [[ " $* " == *" --expired "* ]]; then acquire_watchdog_lock; else acquire_lock; fi; cmd_revert "$@" ;;
  persist) acquire_lock; cmd_persist ;;
  hdr) acquire_lock; cmd_hdr "$@" ;;
  recover) acquire_lock; cmd_recover ;;
  brightness) cmd_brightness "$@" ;;
  identify) cmd_identify ;;
  open) cmd_open ;;
  edid) [[ -n ${1:-} ]] || die "edid needs a display name"; edid_for "$1" ;;
  icc) cmd_icc "$@" ;;
  workspaces) acquire_lock; cmd_workspaces "$@" ;;
  virtual)
    case "${1:-}" in
      secret|clients) cmd_virtual "$@" ;;
      *) acquire_lock; cmd_virtual "$@" ;;
    esac ;;
  doctor) cmd_doctor ;;
  report) cmd_report ;;
  -h|--help|help|"") usage ;;
  *) usage >&2; die "unknown command $cmd" ;;
esac
