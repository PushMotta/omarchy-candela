#!/bin/bash

# omarchy:summary=Configure displays: geometry, signal and colour, with safe apply and revert
# omarchy:args=<state|apply|keep|revert|persist|hdr|brightness|identify|open|edid|icc|recover|doctor> [...]
# omarchy:examples=omarchy-displays state | omarchy-displays hdr on --display DP-2 | omarchy-displays apply @layout.json | omarchy-displays keep | omarchy-displays doctor

# The backend behind the Displays plugin. Everything the UI does is a
# subcommand here, so it is scriptable and bindable.
#
# Model:
#   intent.json          what the user chose through this tool, per connector
#   pending.json         an applied-but-not-kept intent, with an expiry and a token
#   displays-layout.lua  generated from intent + live geometry; Omarchy loads it
#                        after the user's monitors.lua on every reload
#   displays-pending.lua the pending intent in the same form, loaded after the
#                        layout, so a reload from anywhere (Omarchy's clamshell
#                        script, a theme change) re-applies the preview instead
#                        of silently reverting it
#
# `apply` writes pending, applies live through `hyprctl eval` for EVERY
# connected display in one chunk (mixing explicit and auto positions moves
# displays), reads the compositor back to confirm it landed where asked, and
# starts a detached revert timer. `keep` commits pending to intent,
# regenerates the Lua, reloads, and proves the file ran. `revert` (or the
# timer) drops pending and reloads, which restores the last kept
# configuration.
#
# A laptop's built-in panel is switched off through Omarchy's own
# internal-monitor-disable toggle rather than a rule of ours: Omarchy's
# clamshell script honours that flag and would re-enable the panel over a
# plain rule within seconds of any monitor event, and Omarchy's boot-time
# recovery service already clears the flag when no external display is
# connected.

set -Eeuo pipefail
# A set -e exit with no message is the worst failure mode for a tool that
# arms display changes: say where it died. Only fires where errexit would.
trap 'echo "omarchy-displays: aborted at line $LINENO: $BASH_COMMAND" >&2' ERR

PLUGIN_ID="${OMARCHY_DISPLAYS_PLUGIN_ID:-pmotta.displays}"
SELF="$(readlink -f "$0")"
SELF_DIR="$(dirname "$SELF")"
EDID_TOOL="$SELF_DIR/omarchy-displays-edid"

STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
STATE_DIR="${OMARCHY_DISPLAYS_STATE_DIR:-$STATE_HOME/omarchy/displays}"
INTENT_FILE="$STATE_DIR/intent.json"
PENDING_FILE="$STATE_DIR/pending.json"
LUA_FILE="${OMARCHY_DISPLAYS_LUA_FILE:-$STATE_HOME/omarchy/toggles/hypr/displays-layout.lua}"
# Everything below lives beside the layout: Omarchy loads that directory in
# sorted filename order, so "displays-layout" < "displays-pending" <
# "internal-monitor-*" is the precedence, and it is the one we want.
TOGGLES_DIR="$(dirname "$LUA_FILE")"
PENDING_LUA="${OMARCHY_DISPLAYS_PENDING_LUA_FILE:-$TOGGLES_DIR/displays-pending.lua}"
INTERNAL_FLAG="$TOGGLES_DIR/internal-monitor-disable.lua"   # Omarchy's own toggle, shared
INTERNAL_SCALE_FILE="$TOGGLES_DIR/internal-monitor-scale"    # read by Omarchy's clamshell script
REVERT_UNIT="omarchy-displays-revert"
REVERT_SECONDS="${OMARCHY_DISPLAYS_REVERT_SECONDS:-15}"
VERIFY_SECONDS="${OMARCHY_DISPLAYS_VERIFY_SECONDS:-3}"
INTERNAL_RE='^(eDP|LVDS|DSI)-'

# A transient systemd unit (the revert timer) may lack the compositor's
# instance signature; recover it from the newest instance runtime dir, the
# same way omarchy-restart-shell does.
if [[ -z ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
  # No runtime dir at all (Hyprland gone, or a test runner) must not be fatal:
  # with pipefail a failing find takes the whole substitution down with it.
  hypr_root="${XDG_RUNTIME_DIR:-/run/user/$UID}/hypr"
  if [[ -d $hypr_root ]]; then
    hypr_dir=$(find "$hypr_root" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' 2>/dev/null | sort -n | tail -n 1 | cut -d' ' -f2- || true)
    if [[ -n $hypr_dir ]]; then export HYPRLAND_INSTANCE_SIGNATURE=${hypr_dir##*/}; fi
  fi
fi

usage() {
  cat <<'USAGE'
Usage: omarchy-displays <command> [args]

  state                          JSON: displays, capabilities, live and kept config, pending apply
  apply [--now] <json|@file|->   Apply a change live; reverts in 15 s unless kept (--now keeps immediately)
  keep                           Keep the pending change and persist it
  revert [--expired] [--token T] Drop the pending change and restore the kept configuration
  persist                        Regenerate the layout file from the kept configuration
  hdr <on|off|wide> [--display NAME] [--sdr-white NITS] [--now]
  brightness <NAME> [+N%|N%-|N%] Show or set brightness for one display
  identify                       Flash each connector name on its own display
  open                           Open the Displays studio
  edid <NAME>                    Parsed EDID capabilities as JSON
  icc list                       Installed ICC profiles as JSON
  recover                        If every display is off, switch the built-in (or first) one back on
  doctor                         Check that the layout is loaded, the compositor agrees, and nothing fights it

Change JSON shape (any subset per display):
  {"displays":[{"name":"DP-2","bitdepth":10,"cm":"hdr","sdr_max_luminance":203}],
   "global":{"cm_auto_hdr":1}}
USAGE
}

die() { echo "omarchy-displays: $*" >&2; exit 1; }

now_epoch() { date +%s; }
now_ms() { echo $(( $(date +%s%N) / 1000000 )); }

is_internal() { [[ $1 =~ $INTERNAL_RE ]]; }

# Serialize the commands that write state (apply/keep/revert/persist/hdr/recover,
# the last two of which call cmd_apply in-process) so a concurrent invocation —
# an expired revert racing an interactive keep, say — cannot interleave.
acquire_lock() {
  mkdir -p "$STATE_DIR"
  exec 9>"$STATE_DIR/.lock"
  flock 9
}

read_json_arg() {
  local arg="${1:-}"
  if [[ -z $arg || $arg == "-" ]]; then
    cat
  elif [[ $arg == @* ]]; then
    cat "${arg#@}"
  else
    printf '%s' "$arg"
  fi
}

live_json() {
  hyprctl monitors all -j 2>/dev/null || die "hyprctl is not answering"
}

intent_json() {
  if [[ -s $INTENT_FILE ]]; then cat "$INTENT_FILE"; else echo '{"version":1,"displays":{},"global":{}}'; fi
}

pending_json() {
  if [[ -s $PENDING_FILE ]]; then cat "$PENDING_FILE"; else echo 'null'; fi
}

focused_name() {
  live_json | jq -r '[.[] | select(.focused == true)][0].name // ""'
}

edid_for() {
  "$EDID_TOOL" "$1" 2>/dev/null || jq -nc --arg connector "$1" '{connector: $connector, available: false}'
}

# Validation and merge of a change into an intent document. Runs in jq so the
# same rules apply to every entry point. Unknown keys are rejected; every
# value is checked against what hl.monitor accepts.
merge_intent() {
  local intent="$1" change="$2"
  jq -n --argjson intent "$intent" --argjson change "$change" '
    def fail(msg): error("invalid change: " + msg);
    def is_name: type == "string" and test("^[A-Za-z0-9._-]+$");
    def check_display(d):
      (d.name // "" | if is_name then . else fail("display name") end) as $name
      | (d | del(.name) | to_entries | map(
          .key as $k | .value as $v
          | if $v == null then {key: $k, value: null}
            elif $k == "mode" then (if ($v|type)=="string" and ($v|test("^(preferred|highres|highrr|[0-9]+x[0-9]+(@[0-9]+(\\.[0-9]+)?)?)$")) then . else fail("mode") end)
            elif $k == "position" then (if ($v|type)=="string" and ($v|test("^(auto|auto-(left|right|up|down)|-?[0-9]+x-?[0-9]+)$")) then . else fail("position") end)
            elif $k == "scale" then (if (($v|type)=="number" and $v > 0 and $v <= 10) or $v == "auto" then . else fail("scale") end)
            elif $k == "transform" then (if ($v|type)=="number" and ($v|floor)==$v and $v >= 0 and $v <= 7 then . else fail("transform") end)
            elif $k == "vrr" then (if ($v|type)=="number" and ($v|floor)==$v and $v >= -1 and $v <= 3 then . else fail("vrr") end)
            elif $k == "enabled" then (if ($v|type)=="boolean" then . else fail("enabled") end)
            elif $k == "mirror" then (if ($v|type)=="string" and ($v == "" or ($v|is_name)) then . else fail("mirror") end)
            elif $k == "bitdepth" then (if $v == 8 or $v == 10 then . else fail("bitdepth") end)
            elif $k == "cm" then (if ($v|type)=="string" and (["auto","srgb","dcip3","dp3","adobe","wide","edid","hdr","hdredid"] | index($v)) != null then . else fail("cm") end)
            elif $k == "sdr_eotf" then (if ($v|type)=="string" and (["default","gamma22","srgb"] | index($v)) != null then . else fail("sdr_eotf") end)
            elif ($k == "sdrbrightness" or $k == "sdrsaturation") then (if ($v|type)=="number" and $v >= 0 and $v <= 4 then . else fail($k) end)
            elif ($k == "sdr_min_luminance" or $k == "min_luminance") then (if ($v|type)=="number" and $v >= 0 and $v <= 100 then . else fail($k) end)
            elif ($k == "sdr_max_luminance" or $k == "max_luminance" or $k == "max_avg_luminance") then (if ($v|type)=="number" and $v >= 0 and $v <= 10000 then . else fail($k) end)
            elif $k == "icc" then (if ($v|type)=="string" and ($v|test("]==]")|not) and ($v|test("\n")|not) then . else fail("icc") end)
            elif ($k == "supports_hdr" or $k == "supports_wide_color") then (if $v == -1 or $v == 0 or $v == 1 then . else fail($k) end)
            else fail("unknown key " + $k) end
        ) | from_entries) as $fields
      | {name: $name, fields: $fields};
    def check_global(g):
      (g // {}) | to_entries | map(
        .key as $k | .value as $v
        | if $v == null then .
          elif $k == "cm_auto_hdr" then (if $v == 0 or $v == 1 or $v == 2 then . else fail("cm_auto_hdr") end)
          else fail("unknown global " + $k) end
      ) | from_entries;
    # A colour state Hyprland cannot actually show: an ICC transform only
    # applies outside HDR, and a display whose HDR capability is forced off
    # cannot be asked to render HDR. supports_hdr follows the Hyprland
    # convention: -1 forces it off, 0 is auto/EDID (the default), 1 forces it
    # on. Checked on the MERGED display (existing intent + this change,
    # nulls already stripped), not just the incoming fields, so setting one
    # half now and the other half earlier still trips.
    def check_colour(d):
      ((d.cm // "") as $cm | $cm == "hdr" or $cm == "hdredid") as $hdr_cm
      | if ($hdr_cm and ((d.icc // "") | length > 0)) then fail("hdr is unavailable while an ICC profile is set")
        elif ($hdr_cm and d.supports_hdr == -1) then fail("hdr is unavailable while the HDR capability is forced off")
        else d end;
    # Unknown top-level keys (a typo, a stray field) currently apply as a
    # silent no-op that still arms a revert timer; reject them, and reject a
    # change carrying neither of the two keys this tool understands.
    def check_top:
      ($change | keys) as $top
      | (($top - ["displays","global"]) | first) as $unknown
      | if $unknown != null then fail("unknown top-level key " + $unknown)
        elif ($top | length) == 0 then fail("nothing to apply")
        else true end;
    check_top as $ok
    | ($change.displays // []) | map(check_display(.)) as $checked
    | check_global($change.global) as $g
    | reduce $checked[] as $c ($intent;
        . as $acc
        | ((($acc.displays[$c.name] // {}) + $c.fields | with_entries(select(.value != null))) | check_colour(.)) as $merged
        | $acc | .displays[$c.name] = $merged)
    | .global = ((.global // {}) + $g | with_entries(select(.value != null)))
    | .version = 1
  ' 2>&1 || return 1
}

# A display being switched off keeps its rule, so that it comes back where it
# was: record the live mode, position, scale and rotation into intent at the
# moment it goes off, unless intent already says. Without this a re-enabled
# display is generated from its live geometry, which for an off display is
# 0x0 at "preferred", on top of whatever sits at the origin.
remember_geometry() {
  local merged="$1" live="$2" change="$3"
  jq -n --argjson merged "$merged" --argjson live "$live" --argjson change "$change" '
    def r2: (. * 100 | round) / 100;
    reduce ($change.displays // [] | .[] | select(.enabled == false) | .name) as $n ($merged;
      ([$live[] | select(.name == $n and .disabled != true and .width > 0)][0]) as $d
      | if $d == null then . else
          .displays[$n] |= (. + {
            mode: (.mode // "\($d.width)x\($d.height)@\($d.refreshRate | r2)"),
            position: (.position // "\($d.x)x\($d.y)"),
            scale: (.scale // $d.scale),
            transform: (.transform // $d.transform) })
        end)'
}

# Refuse a change that would leave nothing to draw on. The popup and studio
# enforce this too; the CLI must not be the door that gets round it.
check_some_display_stays_on() {
  local intent="$1" live="$2"
  jq -e -n --argjson intent "$intent" --argjson live "$live" '
    [ $live[] | select((.name // "") != "")
      | ($intent.displays[.name] // {}) as $i
      | if $i.enabled == false then false elif $i.enabled == true then true else (.disabled != true) end ]
    | any' >/dev/null 2>&1 || die "refusing to switch off the last enabled display"
}

# Lua generation from intent + live geometry. Every connected, enabled display
# gets a full rule so nothing falls back to Hyprland's auto placement. Values
# were validated on the way into intent, so they are emitted verbatim.
#
# $5 selects the audience: "live" is the chunk sent to `hyprctl eval` and says
# everything, including a laptop panel going off; "file" (default) is what is
# written to disk, where a built-in panel's off state is Omarchy's flag file,
# not a rule of ours (see the header). $4 is a probe token: the file sets a
# global to it so a later `hyprctl eval` can prove the file actually ran.
generate_lua() {
  local intent="$1" live="$2" stamp="${3:-$(date --iso-8601=seconds)}" probe="${4:-}" audience="${5:-file}"
  jq -r -n --argjson intent "$intent" --argjson live "$live" --arg stamp "$stamp" --arg plugin "$PLUGIN_ID" \
        --arg probe "$probe" --arg audience "$audience" --arg internal_re "$INTERNAL_RE" '
    def lua_str: "\"" + (tostring | gsub("\\\\"; "\\\\\\\\") | gsub("\""; "\\\"")) + "\"";
    def lua_val($k): if $k == "icc" then "[==[" + tostring + "]==]" elif type == "string" then lua_str else tostring end;
    def r2: (. * 100 | round) / 100;
    def mode_of($d): if ($d.width // 0) > 0 then "\($d.width)x\($d.height)@\($d.refreshRate | r2)" else "preferred" end;
    # An off display with no say from intent is left to whatever switched it
    # off, except that the file names the built-in panel'"'"'s owner so the
    # rule'"'"'s absence is not a mystery to a reader.
    def rule($d):
      ($intent.displays[$d.name] // {}) as $i
      | ($d.name | test($internal_re)) as $internal
      | if $i.enabled == false or ($d.disabled == true and $i.enabled != true) then
          if $audience == "file" and $internal then
            "-- \($d.name) is off. The built-in panel'"'"'s off state is Omarchy'"'"'s internal-monitor-disable toggle, which its clamshell script honours; this file never carries a rule for it."
          elif $i.enabled == false then
            "hl.monitor({ output = \($d.name | lua_str), disabled = true })"
          else
            ""
          end
        else
          ([ "output = \($d.name | lua_str)",
             "mode = \(($i.mode // mode_of($d)) | lua_str)",
             "position = \(($i.position // "\($d.x)x\($d.y)") | lua_str)",
             "scale = \(($i.scale // $d.scale) | lua_val("scale"))",
             "transform = \(($i.transform // $d.transform // 0) | tostring)" ]
           + ([ "vrr","mirror","bitdepth","cm","sdr_eotf","sdrbrightness","sdrsaturation",
                "sdr_min_luminance","sdr_max_luminance","min_luminance","max_luminance","max_avg_luminance",
                "icc","supports_hdr","supports_wide_color" ]
              | map(. as $k | select($i[$k] != null and ($k != "mirror" or $i[$k] != "") and ($k != "icc" or $i[$k] != "")) | "\($k) = \($i[$k] | lua_val($k))")))
          | "hl.monitor({ " + join(", ") + " })"
        end;
    [ "-- Generated by \($plugin) (omarchy-displays). Do not edit: it is rewritten on every keep.",
      "-- Kept \($stamp). Change displays with the Displays panel or `omarchy-displays`.",
      "" ]
    + [ $live[] | select((.name // "") != "") | rule(.) | select(. != "") ]
    + (if ($intent.global.cm_auto_hdr != null) then ["", "hl.config({ render = { cm_auto_hdr = \($intent.global.cm_auto_hdr) } })"] else [] end)
    + (if $probe != "" then ["", "-- Load probe: `omarchy-displays doctor` asks Hyprland whether this value is set.", "omarchy_displays_layout_probe = \($probe | lua_str)"] else [] end)
    | join("\n")
  '
}

# Live apply sends only statements: hyprctl parses a leading "--" as one of
# its own flags, so the file header must never reach `hyprctl eval`. Reports
# failure through stdout + exit status instead of calling die() directly, so
# the caller can unwind the pending change before the process exits.
apply_live() {
  local chunk statements output
  chunk="$1"
  statements="$(printf '%s\n' "$chunk" | grep -vE '^[[:space:]]*(--|$)')"
  [[ -n $statements ]] || return 0
  output="$(hyprctl eval "$statements" 2>&1)" || { printf '%s' "$output"; return 1; }
  if [[ $output != ok* ]]; then printf '%s' "$output"; return 1; fi
}

# Read the compositor back until it matches the intent, or give up after
# VERIFY_SECONDS. Hyprland can accept a chunk and still land elsewhere (a mode
# it quietly falls back from, a scale it corrects); "ok" from eval is not the
# same as the change being on the glass. Prints the mismatches on failure.
# Only fields the intent names are compared, and only ones hyprctl reports
# faithfully: position and mode are skipped on a mirror, cm only for presets
# Hyprland echoes back verbatim, scale to hyprctl's two decimals.
verify_live() {
  local intent="$1" deadline mismatch live
  deadline=$(( $(now_ms) + $(awk -v s="$VERIFY_SECONDS" 'BEGIN { printf "%d", s * 1000 }') ))
  while :; do
    live="$(hyprctl monitors all -j 2>/dev/null)" || { printf 'hyprctl is not answering'; return 1; }
    mismatch="$(jq -r -n --argjson intent "$intent" --argjson live "$live" '
      def depth_of: if test("2101010") then 10 elif test("16161616") then 16 else 8 end;
      def r2: (. * 100 | round) / 100;
      [ ($intent.displays // {}) | to_entries[] | .key as $n | .value as $i
        | ([$live[] | select(.name == $n)][0]) as $d
        | select($d != null)
        | if $i.enabled == false then
            (if $d.disabled != true then "\($n) is still on" else empty end)
          elif $d.disabled == true then
            (if $i.enabled == true then "\($n) is still off" else empty end)
          else
            ( if ($i.mirror // "") != "" then
                (if $d.mirrorOf != $i.mirror then "\($n) mirrors \($d.mirrorOf), wanted \($i.mirror)" else empty end)
              else
                (if $i.mirror == "" and $d.mirrorOf != "none" and $d.mirrorOf != null then "\($n) still mirrors \($d.mirrorOf)" else empty end),
                (if ($i.mode // "" | test("^[0-9]+x[0-9]+")) then
                    ($i.mode | capture("^(?<w>[0-9]+)x(?<h>[0-9]+)(@(?<r>[0-9.]+))?")) as $m
                    | (if $d.width != ($m.w | tonumber) or $d.height != ($m.h | tonumber) then "\($n) mode \($d.width)x\($d.height), wanted \($m.w)x\($m.h)" else empty end),
                      (if $m.r != null and (($d.refreshRate - ($m.r | tonumber)) | fabs) > 0.2 then "\($n) refresh \($d.refreshRate | r2) Hz, wanted \($m.r)" else empty end)
                  else empty end),
                (if ($i.position // "" | test("^-?[0-9]+x-?[0-9]+$")) then
                    ($i.position | capture("^(?<x>-?[0-9]+)x(?<y>-?[0-9]+)$")) as $p
                    | (if $d.x != ($p.x | tonumber) or $d.y != ($p.y | tonumber) then "\($n) at \($d.x)x\($d.y), wanted \($i.position)" else empty end)
                  else empty end),
                (if ($i.scale | type) == "number" and (($d.scale - $i.scale) | fabs) > 0.006 then "\($n) scale \($d.scale), wanted \($i.scale)" else empty end),
                (if $i.transform != null and $d.transform != $i.transform then "\($n) transform \($d.transform), wanted \($i.transform)" else empty end)
              end ),
            (if $i.bitdepth != null and ($d.currentFormat // "" | depth_of) != $i.bitdepth then "\($n) is \($d.currentFormat // "" | depth_of)-bit, wanted \($i.bitdepth)" else empty end),
            (if ($i.cm // "" | IN("srgb", "hdr", "hdredid")) and $d.colorManagementPreset != $i.cm then "\($n) colour preset \($d.colorManagementPreset), wanted \($i.cm)" else empty end),
            (if $i.sdr_max_luminance != null and (($d.sdrMaxLuminance // 0) | round) != ($i.sdr_max_luminance | round) then "\($n) SDR white \($d.sdrMaxLuminance) cd/m², wanted \($i.sdr_max_luminance)" else empty end)
          end
      ] | join("; ")')"
    [[ -n $mismatch ]] || return 0
    (( $(now_ms) >= deadline )) && break
    sleep 0.2
  done
  printf '%s' "$mismatch"
  return 1
}

# Did the layout file run on the last reload? It sets a global to the probe
# written into it; asking Hyprland for that global is the only proof that the
# toggles directory is still being loaded.
probe_loaded() {
  local out
  out="$(hyprctl eval "assert(omarchy_displays_layout_probe == \"$1\", \"displays-layout.lua did not run\")" 2>&1)" || return 1
  [[ $out == ok* ]]
}

stop_timer() {
  systemctl --user stop "$REVERT_UNIT.timer" "$REVERT_UNIT.service" >/dev/null 2>&1 || true
}

start_timer() {
  local token="$1"
  stop_timer
  systemd-run --user --quiet --collect --unit="$REVERT_UNIT" \
    --on-active="${REVERT_SECONDS}s" --timer-property=AccuracySec=200ms \
    -- "$SELF" revert --expired --token "$token" >/dev/null 2>&1 || {
    # No systemd user manager (tests, odd sessions): fall back to a detached
    # shell. It must drop fd 9 (acquire_lock's flock) first: it outlives this
    # process for the whole revert window and would otherwise hold the state
    # lock the entire time, blocking an interactive keep/apply/revert.
    (setsid bash -c "exec 9>&-; sleep $REVERT_SECONDS; '$SELF' revert --expired --token '$token'" >/dev/null 2>&1 &)
  }
}

notify_shell() {
  omarchy-shell -q "$PLUGIN_ID" refresh 2>/dev/null || true
}

# A temp file beside $1, not a fixed name, so two concurrent writers cannot
# clobber each other's temp file. Caller does `cmd > "$tmp" && mv "$tmp" "$1"`.
tmp_for() { mktemp "$(dirname "$1")/.$(basename "$1").XXXXXX"; }

# ---------------------------------------------------------------- built-in panel
#
# The built-in panel's off state is Omarchy's flag file, and a change that
# touches it records what the flag looked like before, so revert can put it
# back. One panel per machine, so one flag.

# What this change says about the built-in panel: "off", "on", or "" for nothing.
internal_verdict() {
  jq -r --arg re "$INTERNAL_RE" '
    [ .displays // [] | .[] | select(.name | test($re)) | select(has("enabled")) | .enabled ]
    | if length == 0 then "" elif .[-1] == false then "off" else "on" end' <<<"$1"
}

internal_name_in() {
  jq -r --arg re "$INTERNAL_RE" '[ .displays // [] | .[] | select(.name | test($re)) | select(has("enabled")) | .name ] | last // ""' <<<"$1"
}

flag_snapshot() {
  if [[ -f $INTERNAL_FLAG ]]; then jq -nc --arg c "$(cat "$INTERNAL_FLAG")" '{present: true, content: $c}'
  else echo '{"present":false}'; fi
}

restore_flag() {
  local snap="${1:-null}"
  [[ -n $snap && $snap != null ]] || return 0
  if [[ $(jq -r '.present' <<<"$snap") == true ]]; then
    mkdir -p "$TOGGLES_DIR"
    jq -r '.content' <<<"$snap" > "$INTERNAL_FLAG"
  else
    rm -f "$INTERNAL_FLAG"
  fi
}

# Same content Omarchy's own `omarchy-hyprland-monitor-internal off` writes.
apply_internal_verdict() {
  local verdict="$1" name="$2"
  case "$verdict" in
    off) mkdir -p "$TOGGLES_DIR"; printf 'hl.monitor({ output = "%s", disabled = true })\n' "$name" > "$INTERNAL_FLAG" ;;
    on) rm -f "$INTERNAL_FLAG" ;;
  esac
}

# The flag is the source of truth for the panel's off state, so intent never
# stores "enabled" for it: a stale value there would fight Omarchy's own
# toggle on the next keep.
strip_internal_enabled() {
  jq --arg re "$INTERNAL_RE" '.displays |= with_entries(if (.key | test($re)) then .value |= del(.enabled) else . end)' <<<"$1"
}

# Omarchy's clamshell script restores the panel at the scale in this file when
# it cannot read one from monitors.lua (it never reads our layout), so keep
# it current with what was kept. Only where that script exists.
write_internal_scale() {
  local intent="$1" live="$2" scale
  command -v omarchy-hyprland-monitor-clamshell >/dev/null 2>&1 || return 0
  scale="$(jq -r -n --argjson intent "$intent" --argjson live "$live" --arg re "$INTERNAL_RE" '
    ([$live[] | select(.name | test($re))][0]) as $d
    | if $d == null then "" else (($intent.displays[$d.name] // {}).scale // (if $d.disabled != true and $d.scale > 0 then $d.scale else "" end)) end
    | if (type == "number") then tostring else "" end')"
  [[ $scale =~ ^[0-9]+([.][0-9]+)?$ ]] || return 0
  mkdir -p "$TOGGLES_DIR"
  printf '%s\n' "$scale" > "$INTERNAL_SCALE_FILE"
}

# ---------------------------------------------------------------- state files

# Undo a pending apply that never fully landed: stop the timer, drop the
# pending files, put Omarchy's flag back, and reload so hyprctl falls back to
# the last kept Lua.
unwind_pending() {
  local before=null
  [[ -s $PENDING_FILE ]] && before="$(jq -c '.internalFlagBefore // null' "$PENDING_FILE")"
  stop_timer
  rm -f "$PENDING_FILE" "$PENDING_LUA"
  restore_flag "$before"
  hyprctl reload >/dev/null 2>&1 || true
}

# Reload so Hyprland re-reads the just-written layout, then check for config
# errors, prove the file ran, and read the displays back — the one path both
# `keep` and `apply --now` use, so a bad write is never silently reported as
# kept.
reload_and_check() {
  local intent="$1" probe="${2:-}" errors mismatch
  hyprctl reload >/dev/null 2>&1 || true
  errors="$(hyprctl configerrors 2>/dev/null | grep -v '^ok$' || true)"
  notify_shell
  [[ -z $errors ]] || die "kept, but Hyprland reports config errors: $errors"
  if [[ -n $probe ]] && ! probe_loaded "$probe"; then
    die "kept, but Hyprland did not run $LUA_FILE on reload: is require(\"default.hypr.toggles\") still in ~/.config/hypr/hyprland.lua? \`omarchy-displays doctor\` explains."
  fi
  if ! mismatch="$(verify_live "$intent")"; then
    die "kept, but the compositor did not land on it: $mismatch"
  fi
}

LAST_PROBE=""
commit_intent() {
  local intent="$1" live tmp probe
  live="$(live_json)"
  intent="$(strip_internal_enabled "$intent")"
  probe="$(now_epoch)-$$-$RANDOM"
  mkdir -p "$STATE_DIR" "$TOGGLES_DIR"
  tmp="$(tmp_for "$INTENT_FILE")"
  printf '%s\n' "$intent" | jq . > "$tmp" && mv "$tmp" "$INTENT_FILE"
  tmp="$(tmp_for "$LUA_FILE")"
  generate_lua "$intent" "$live" "" "$probe" file > "$tmp" && mv "$tmp" "$LUA_FILE"
  write_internal_scale "$intent" "$live"
  LAST_PROBE="$probe"
}

# ---------------------------------------------------------------- commands

cmd_state() {
  local live intent pending focused edids brightness auto_hdr sdr_eotf internal_flag
  live="$(live_json)"
  intent="$(intent_json)"
  pending="$(pending_json)"
  focused="$(printf '%s' "$live" | jq -r '[.[] | select(.focused == true)][0].name // ""')"

  edids="{}"
  while IFS= read -r name; do
    [[ -n $name ]] || continue
    edids="$(jq -c --arg n "$name" --argjson e "$(edid_for "$name")" '. + {($n): $e}' <<<"$edids")"
  done < <(printf '%s' "$live" | jq -r '.[].name')

  brightness=""
  [[ -n $focused ]] && brightness="$(omarchy-brightness-display --monitor "$focused" 2>/dev/null || true)"
  auto_hdr="$(hyprctl getoption render:cm_auto_hdr -j 2>/dev/null | jq '.int // null' 2>/dev/null || echo null)"
  sdr_eotf="$(hyprctl getoption render:cm_sdr_eotf -j 2>/dev/null | jq -r '.str // "default"' 2>/dev/null || echo default)"
  internal_flag=false; [[ -f $INTERNAL_FLAG ]] && internal_flag=true

  jq -n --argjson live "$live" --argjson intent "$intent" --argjson pending "$pending" \
        --argjson edids "$edids" --arg focused "$focused" --arg brightness "$brightness" \
        --argjson autoHdr "$auto_hdr" --arg sdrEotf "$sdr_eotf" --arg pluginId "$PLUGIN_ID" \
        --argjson revertSeconds "$REVERT_SECONDS" --argjson now "$(now_epoch)" \
        --argjson internalFlag "$internal_flag" --arg internalRe "$INTERNAL_RE" '
    def bitdepth_of: if test("2101010") then 10 elif test("16161616") then 16 else 8 end;
    {
      version: 1,
      pluginId: $pluginId,
      now: $now,
      focused: $focused,
      revertSeconds: $revertSeconds,
      pending: (if $pending == null then null else { since: $pending.since, expires: $pending.expires, remaining: ([$pending.expires - $now, 0] | max) } end),
      global: { cm_auto_hdr: $autoHdr, cm_sdr_eotf: $sdrEotf, kept: ($intent.global // {}), pending: (($pending.intent.global // {}) ), internalPanelOffByOmarchy: $internalFlag },
      displays: [ $live[] | {
        name, description, make, model, serial: (.serial | gsub("^\\s+|\\s+$"; "")),
        internal: (.name | test($internalRe)),
        enabled: (.disabled != true), focused, dpms: .dpmsStatus,
        width, height, refreshRate, x, y, scale, transform, vrr, mirrorOf,
        physicalWidth, physicalHeight, currentFormat, availableModes,
        live: {
          bitdepth: (.currentFormat | bitdepth_of),
          cm: .colorManagementPreset,
          sdrBrightness, sdrSaturation, sdrMinLuminance, sdrMaxLuminance
        },
        capabilities: ($edids[.name] // {connector: .name, available: false}),
        brightness: (if .name == $focused and ($brightness | test("^[0-9]+$")) then ($brightness | tonumber) else null end),
        kept: ($intent.displays[.name] // {}),
        pendingConfig: (($pending.intent.displays // {})[.name] // null)
      } ]
    }'
}

cmd_apply() {
  local now=0
  if [[ ${1:-} == "--now" ]]; then now=1; shift; fi
  local change intent base merged live chunk_live chunk_file
  change="$(read_json_arg "${1:-}")"
  [[ -n $change ]] || die "apply needs a JSON change"
  printf '%s' "$change" | jq -e . >/dev/null 2>&1 || die "change is not valid JSON"

  # Chain onto a pending change, so successive slider moves accumulate.
  local before_flag=null
  if [[ -s $PENDING_FILE ]]; then
    base="$(jq -c '.intent' "$PENDING_FILE")"
    before_flag="$(jq -c '.internalFlagBefore // null' "$PENDING_FILE")"
  else
    base="$(intent_json)"
  fi
  merged="$(merge_intent "$base" "$change")" || die "${merged#jq: error (at <unknown>): }"
  live="$(live_json)"
  merged="$(remember_geometry "$merged" "$live" "$change")"
  check_some_display_stays_on "$merged" "$live"
  chunk_live="$(generate_lua "$merged" "$live" "" "" live)"

  local verdict internal
  verdict="$(internal_verdict "$change")"
  internal="$(internal_name_in "$change")"
  # The first change in a chain to touch the panel's flag records what it
  # looked like before; later ones in the same chain keep that original.
  if [[ -n $verdict && $before_flag == null ]]; then before_flag="$(flag_snapshot)"; fi

  # Pending is written and the timer armed BEFORE the live displays are
  # touched, so a hyprctl rejection partway through, or the process being
  # killed, always leaves a revert ready to unwind whatever did land.
  mkdir -p "$STATE_DIR"
  local token since expires tmp
  token="$(now_epoch)-$$-$RANDOM"
  since="$(now_epoch)"; expires=$(( since + REVERT_SECONDS ))
  tmp="$(tmp_for "$PENDING_FILE")"
  jq -n --argjson intent "$merged" --argjson since "$since" --argjson expires "$expires" --arg token "$token" --argjson before "$before_flag" \
    '{since: $since, expires: $expires, token: $token, intent: $intent, internalFlagBefore: $before}' > "$tmp" && mv "$tmp" "$PENDING_FILE"
  start_timer "$token"

  if (( ! now )); then
    # The preview on disk, loaded after the layout: a reload from anywhere
    # during the window re-applies it instead of reverting it.
    mkdir -p "$TOGGLES_DIR"
    chunk_file="$(generate_lua "$merged" "$live" "pending since $since; reverts at $expires unless kept" "" file)"
    tmp="$(tmp_for "$PENDING_LUA")"
    printf '%s\n' "$chunk_file" > "$tmp" && mv "$tmp" "$PENDING_LUA"
  fi
  apply_internal_verdict "$verdict" "$internal"

  local err
  if ! err="$(apply_live "$chunk_live")"; then
    unwind_pending
    die "hyprctl rejected the change: $err"
  fi
  if ! err="$(verify_live "$merged")"; then
    unwind_pending
    die "applied, but the compositor did not land on it, so it was undone: $err"
  fi

  if (( now )); then
    stop_timer
    rm -f "$PENDING_FILE" "$PENDING_LUA"
    commit_intent "$merged"
    reload_and_check "$(intent_json)" "$LAST_PROBE"
    echo "kept"
    return
  fi

  notify_shell
  echo "pending $expires"
}

cmd_keep() {
  [[ -s $PENDING_FILE ]] || { echo "nothing pending"; return 0; }
  local intent
  intent="$(jq -c '.intent' "$PENDING_FILE")"
  stop_timer
  commit_intent "$intent"
  rm -f "$PENDING_FILE" "$PENDING_LUA"
  reload_and_check "$(intent_json)" "$LAST_PROBE"
  echo "kept"
}

cmd_revert() {
  local expired=0 token=""
  while (( $# > 0 )); do
    case "$1" in
      --expired) expired=1; shift ;;
      --token) token="${2:-}"; shift 2 ;;
      *) die "revert: unknown option $1" ;;
    esac
  done

  if (( expired )); then
    # The setsid fallback timer (start_timer) cannot be cancelled, so a
    # stale one must never revert a change that was since kept or replaced
    # by a newer apply: only act when pending.json still names this token.
    if [[ ! -s $PENDING_FILE ]] || [[ "$(jq -r '.token // empty' "$PENDING_FILE")" != "$token" ]]; then
      echo "nothing to revert"
      return 0
    fi
  fi

  # When the timer itself runs this, stopping the transient service would
  # SIGTERM this very process before the pending file is removed. The timer
  # has already elapsed, so only an interactive revert needs to cancel it.
  (( expired )) || stop_timer
  local had_pending=0 before=null
  if [[ -s $PENDING_FILE ]]; then had_pending=1; before="$(jq -c '.internalFlagBefore // null' "$PENDING_FILE")"; fi
  rm -f "$PENDING_FILE" "$PENDING_LUA"
  restore_flag "$before"
  hyprctl reload >/dev/null 2>&1 || true
  if (( expired && had_pending )); then
    omarchy-notification-send "Display changes reverted" "They were not kept within ${REVERT_SECONDS} seconds." -t 4000 2>/dev/null || true
  fi
  notify_shell
  echo "reverted"
  # The reload is the whole of the revert, so say so if it did not take:
  # an exit code the shell can show beats a display quietly left changed.
  local mismatch
  if (( had_pending )) && ! mismatch="$(verify_live "$(intent_json)")"; then
    echo "omarchy-displays: reverted, but the compositor did not return to the kept configuration: $mismatch" >&2
    exit 1
  fi
}

cmd_persist() {
  commit_intent "$(intent_json)"
  echo "$LUA_FILE"
}

cmd_hdr() {
  local mode="${1:-}"; shift || true
  [[ $mode =~ ^(on|off|wide)$ ]] || die "hdr needs on, off or wide"
  local display="" sdr_white="" now=()
  while (( $# > 0 )); do
    case "$1" in
      --display) display="${2:-}"; shift 2 ;;
      --sdr-white) sdr_white="${2:-}"; shift 2 ;;
      --now) now=(--now); shift ;;
      *) die "unknown option $1" ;;
    esac
  done
  [[ -n $display ]] || display="$(focused_name)"
  [[ -n $display ]] || die "no focused display"
  local caps change
  caps="$(edid_for "$display")"
  change="$(jq -nc --arg name "$display" --arg mode "$mode" --arg white "$sdr_white" --argjson caps "$caps" '
    def clamp($lo; $hi): if . < $lo then $lo elif . > $hi then $hi else . end;
    ($caps.hdr.maxFrameAverageLuminance // $caps.hdr.maxLuminance // 400) as $avg
    | (if $white != "" then ($white | tonumber) else 203 end | clamp(80; ([$avg, 80] | max)) | round) as $sdrWhite
    | { displays: [
        if $mode == "off" then { name: $name, bitdepth: 8, cm: "srgb", sdr_max_luminance: null, sdr_min_luminance: null }
        elif $mode == "wide" then { name: $name, bitdepth: 10, cm: "auto", sdr_max_luminance: null, sdr_min_luminance: null }
        else { name: $name, bitdepth: 10, cm: "hdr", sdr_max_luminance: $sdrWhite,
               sdr_min_luminance: (if ($caps.hdr.minLuminance // 0) > 0 then $caps.hdr.minLuminance else 0.2 end) }
        end ] }')"
  if [[ $mode == "on" ]] && ! jq -e '.supportsHdr == true' <<<"$caps" >/dev/null; then
    echo "omarchy-displays: $display does not advertise HDR (ST 2084) in its EDID; applying anyway" >&2
  fi
  cmd_apply "${now[@]}" "$change"
}

cmd_brightness() {
  local name="${1:-}"; shift || true
  [[ -n $name ]] || die "brightness needs a display name"
  omarchy-brightness-display --no-osd --monitor "$name" "$@"
}

cmd_identify() {
  omarchy-shell "$PLUGIN_ID" identify >/dev/null 2>&1 || die "the Displays plugin is not running"
}

cmd_open() {
  omarchy-shell shell summon "$PLUGIN_ID" '{}' >/dev/null 2>&1 || die "the Displays plugin is not running"
}

cmd_icc() {
  [[ ${1:-list} == "list" ]] || die "icc supports: list"
  local dirs=("$HOME/.local/share/icc" "$HOME/.color/icc" "$HOME/.local/share/color/icc" /usr/share/color/icc /usr/local/share/color/icc)
  {
    for d in "${dirs[@]}"; do
      [[ -d $d ]] || continue
      find "$d" -type f \( -iname '*.icc' -o -iname '*.icm' \) -print0 2>/dev/null
    done
  } | sort -z | jq -Rsc 'split(" ") | map(select(length > 0)) | map({path: ., name: (split("/") | last)})'
}

# A machine with every display off has nowhere to show a Keep button. A kept
# layout that switches one display off is unconditional in Lua, so booting it
# without the other display attached leaves the screen black; Omarchy's own
# recovery unit covers its flag, this covers ours. Prefer the built-in panel,
# the one display a laptop always has, else whatever comes first.
cmd_recover() {
  local live rescue
  live="$(live_json)"
  if ! jq -e 'length > 0 and all(.disabled == true)' <<<"$live" >/dev/null; then
    echo "nothing to recover"
    return 0
  fi
  rescue="$(jq -r --arg re "$INTERNAL_RE" '([.[] | select(.name | test($re))][0] // .[0]).name' <<<"$live")"
  omarchy-notification-send "Displays" "Every display was off. Switching $rescue back on." -t 6000 2>/dev/null || true
  cmd_apply --now "$(jq -nc --arg n "$rescue" '{displays: [{name: $n, enabled: true}]}')" >/dev/null
  echo "recovered $rescue"
}

# Everything that has to hold for keep and revert to mean what they say,
# checked and said in one place. Exit 1 on anything that would break them.
cmd_doctor() {
  local status=0 live="" line
  ok() { echo "ok    $*"; }
  warn() { echo "warn  $*"; }
  bad() { echo "FAIL  $*"; status=1; }

  if live="$(hyprctl monitors all -j 2>/dev/null)"; then
    ok "hyprctl answers: $(jq 'length' <<<"$live") displays, $(hyprctl version 2>/dev/null | head -1 | cut -d' ' -f1-2)"
  else
    bad "hyprctl is not answering"
    live="[]"
  fi

  local hypr_lua="$HOME/.config/hypr/hyprland.lua"
  if [[ -f $hypr_lua ]]; then
    if grep -qE '^[[:space:]]*require\("default\.hypr\.toggles"\)' "$hypr_lua"; then
      ok "hyprland.lua loads the toggles directory, where the kept layout lives"
    else
      bad "$hypr_lua does not require(\"default.hypr.toggles\"): the kept layout is never read, and revert cannot restore it"
    fi
  else
    warn "$hypr_lua not found; this tool expects Omarchy's Lua config"
  fi

  if [[ -f $LUA_FILE ]]; then
    local probe
    probe="$(sed -nE 's/^omarchy_displays_layout_probe = "([^"]+)"$/\1/p' "$LUA_FILE" | head -1)"
    if [[ -z $probe ]]; then
      warn "$LUA_FILE predates the load probe: run \`omarchy-displays persist\`, then \`hyprctl reload\`"
    elif probe_loaded "$probe"; then
      ok "Hyprland ran $LUA_FILE on its last reload"
    else
      bad "Hyprland did not run $LUA_FILE on its last reload"
    fi
  else
    ok "nothing kept yet: your monitors.lua is in charge"
  fi

  local errors
  errors="$(hyprctl configerrors 2>/dev/null | grep -v '^ok$' || true)"
  if [[ -z $errors ]]; then ok "no Hyprland config errors"; else bad "Hyprland config errors: $errors"; fi

  if [[ -s $PENDING_FILE ]]; then
    local expires
    expires="$(jq -r '.expires // 0' "$PENDING_FILE")"
    if (( expires < $(now_epoch) )); then
      warn "a pending change expired without reverting: run \`omarchy-displays revert\`"
    else
      ok "a change is pending, $(( expires - $(now_epoch) )) s left"
    fi
  fi
  if [[ -f $PENDING_LUA && ! -s $PENDING_FILE ]]; then
    bad "$PENDING_LUA exists with nothing pending; delete it and \`hyprctl reload\`"
  fi

  for d in "$STATE_DIR" "$TOGGLES_DIR"; do
    mkdir -p "$d" 2>/dev/null && [[ -w $d ]] && ok "$d is writable" || bad "$d is not writable"
  done

  local tool
  for tool in edid-decode jq socat; do
    command -v "$tool" >/dev/null 2>&1 && ok "$tool found" || bad "$tool not found"
  done
  command -v ddcutil >/dev/null 2>&1 || command -v brightnessctl >/dev/null 2>&1 && ok "brightness tools found" || warn "neither ddcutil nor brightnessctl found: no brightness control"
  if command -v systemd-run >/dev/null 2>&1 && systemctl --user is-system-running >/dev/null 2>&1; then
    ok "systemd user manager runs the revert timer"
  else
    warn "no systemd user manager: the revert timer falls back to a detached shell"
  fi

  local internal monitors_lua="$HOME/.config/hypr/monitors.lua"
  internal="$(jq -r --arg re "$INTERNAL_RE" '[.[] | select(.name | test($re))][0].name // ""' <<<"$live")"
  if pgrep -f omarchy-hyprland-monitor-watch >/dev/null 2>&1; then
    if [[ -n $internal ]]; then
      local configured
      configured="$(sed -nE 's/^[[:space:]]*local[[:space:]]+omarchy_monitor_scale[[:space:]]*=[[:space:]]*([^[:space:]]+).*/\1/p' "$monitors_lua" 2>/dev/null | head -1)"
      if [[ $configured =~ ^[0-9]+([.][0-9]+)?$ ]]; then
        warn "monitors.lua sets omarchy_monitor_scale = $configured; Omarchy's clamshell script re-applies that scale to $internal with position auto on lid and monitor events, over the kept layout. Set it to \"auto\" there and choose the scale here."
      else
        ok "Omarchy's monitor watcher is running; with scale = \"auto\" in monitors.lua it leaves the kept layout alone"
      fi
      [[ -f $INTERNAL_FLAG ]] && ok "$internal is off through Omarchy's internal-monitor-disable toggle" || true
    else
      ok "Omarchy's monitor watcher is running; no built-in panel, nothing for it to reconcile"
    fi
  fi

  if [[ -f $monitors_lua ]]; then
    while IFS= read -r line; do
      [[ -n $line ]] || continue
      if grep -qE "^[^-]*hl\.monitor\(\{[^}]*output[[:space:]]*=[[:space:]]*\"$line\"" "$monitors_lua"; then
        warn "monitors.lua has its own rule for $line; the kept layout loads later and wins"
      fi
    done < <(intent_json | jq -r '.displays | keys[]')
  fi

  local dupes
  dupes="$(jq -r 'group_by(.make + "|" + .model + "|" + (.serial | gsub("^\\s+|\\s+$"; ""))) | map(select(length > 1) | map(.name) | join(" and ")) | .[]' <<<"$live")"
  while IFS= read -r line; do
    [[ -n $line ]] || continue
    ok "$line report the same make, model and serial; rules key them by connector, and their EDID hashes tell them apart"
  done <<<"$dupes"

  # exit, not return: a non-zero return would trip the ERR trap's "aborted"
  # line, and this exit is the verdict, not an accident.
  (( status == 0 )) || exit 1
}

cmd="${1:-}"; shift || true
case "$cmd" in
  state) cmd_state ;;
  apply) acquire_lock; cmd_apply "$@" ;;
  keep) acquire_lock; cmd_keep ;;
  revert) acquire_lock; cmd_revert "$@" ;;
  persist) acquire_lock; cmd_persist ;;
  hdr) acquire_lock; cmd_hdr "$@" ;;
  recover) acquire_lock; cmd_recover ;;
  brightness) cmd_brightness "$@" ;;
  identify) cmd_identify ;;
  open) cmd_open ;;
  edid) [[ -n ${1:-} ]] || die "edid needs a display name"; edid_for "$1" ;;
  icc) cmd_icc "$@" ;;
  doctor) cmd_doctor ;;
  -h|--help|help|"") usage ;;
  *) usage >&2; die "unknown command $cmd" ;;
esac
